@using Maison.Models
@model Maison.Models.Sanpham
@{
    ViewBag.Title = "Chi tiết sản phẩm";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var info = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
    /* =======================================
       CSS SIDEBAR TRƯỢT (THÔNG SỐ KỸ THUẬT)
       ======================================= */
    .sticky-specs-sidebar {
        position: -webkit-sticky;
        position: sticky;
        top: 90px; /* Cách mép trên màn hình 90px khi cuộn */
        z-index: 9;
        transition: all 0.3s ease;
    }

    /* Thu nhỏ chữ bảng thông số để fit vừa cột 4 (33% màn hình) */
    .tech-specs-table th {
        width: 40%; /* Nới rộng cột Tiêu đề (RAM, CPU) ra xíu */
        font-size: 13px; /* Ép nhỏ chữ */
        padding: 10px 12px;
    }

    .tech-specs-table td {
        font-size: 13px; /* Ép nhỏ chữ */
        padding: 10px 12px;
    }
    /* =======================================
       CSS Ô CHỌN CẤU HÌNH (Giữ nguyên của bạn)
       ======================================= */
    /* =======================================
       CSS THANH CUỘN VÀ TRƯỢT DÍNH (STICKY)
       ======================================= */
    /* Làm cho cả cột bên phải trượt theo khi cuộn chuột */
    /* =======================================
       CSS THANH CUỘN VÀ TRƯỢT DÍNH (NÂNG CẤP SANG TRỌNG)
       ======================================= */
    .sticky-right-column {
        position: -webkit-sticky;
        position: sticky;
        top: 90px; /* Cách header 90px cho thoáng */
        z-index: 10;
        background: #fff;
        border-radius: 16px; /* Bo góc mềm mại hơn */
        padding: 25px; /* Padding rộng rãi sang trọng */
        border: 1px solid #e5e7eb;
        box-shadow: 0 10px 40px rgba(0,0,0,0.08); /* Đổ bóng sâu, nổi bần bật */
    }

    /* Khu vực cuộn tàng hình (Xóa nền xám, xóa viền cứng) */
    .config-scroll-box {
        max-height: 300px; /* Kéo dài thêm xíu cho thoải mái */
        overflow-y: auto;
        padding-right: 8px; /* Chừa chỗ cho thanh cuộn */
        margin-top: 15px;
        margin-bottom: 20px;
    }
        /* Làm thanh cuộn thanh mảnh và mượt */
        .config-scroll-box::-webkit-scrollbar {
            width: 5px;
        }

        .config-scroll-box::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }

        .config-scroll-box::-webkit-scrollbar-track {
            background: transparent;
        }

    /* =======================================
       NÚT CẤU HÌNH (GỌN GÀNG, TINH TẾ)
       ======================================= */
    .variant-box {
        border: 1px solid #d1d5db;
        border-radius: 8px; /* Bo góc vừa phải */
        padding: 8px 12px; /* Thu gọn padding trên dưới lại */
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        margin-right: 8px;
        margin-bottom: 10px;
        background: #fff;
        color: #333;
        font-size: 13px; /* Chữ nhỏ gọn lại */
        font-weight: 500;
        transition: all 0.2s ease;
        position: relative;
    }

        .variant-box.disabled-variant {
            opacity: 0.75; /* Tăng độ hiển thị lên 75% để chữ rõ ràng, dễ đọc hơn */
            cursor: not-allowed;
            background-color: #f8f9fa; /* Nền xám nhạt nhẹ nhàng */
            border-color: #ced4da; /* Viền xám đậm hơn chút cho rõ form */
            color: #6c757d; /* Màu chữ xám đậm, không bị chìm nghỉm nữa */
            /* TIỂU XẢO PRO: Thêm một đường gạch chéo mờ mờ từ góc này sang góc kia 
           để khách nhìn phát biết ngay là "Cấu hình này không khả dụng" */
            background-image: linear-gradient(to top right, transparent calc(50% - 1px), #dee2e6 calc(50%), transparent calc(50% + 1px) );
        }

        .variant-box:hover:not(.disabled-variant) {
            border-color: #d70018;
            color: #d70018;
        }

        .variant-box.active {
            border: 2px solid #d70018;
            color: #d70018;
            font-weight: 700;
            background: #fff5f5;
        }

            .variant-box.active::before {
                content: '\f00c';
                font-family: 'Font Awesome 5 Free';
                font-weight: 900;
                position: absolute;
                top: -8px;
                right: -8px;
                background: #d70018;
                color: white;
                border-radius: 50%;
                width: 16px;
                height: 16px;
                font-size: 9px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

    /* =======================================
       CSS BẢNG THÔNG SỐ (Giữ nguyên của bạn)
       ======================================= */
    .tech-specs-table th {
        background-color: #f3f4f6;
        width: 35%;
        font-weight: 600;
        color: #333;
    }

    .tech-specs-table td, .tech-specs-table th {
        padding: 12px 15px;
        border: 1px solid #e5e7eb;
    }

    /* =======================================
       CSS SLIDER VÀ THUMBNAIL (Giữ nguyên của bạn)
       ======================================= */
    .btn-slide {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        width: 40px;
        height: 40px;
        border: none;
        border-radius: 50%;
        background: rgba(0,0,0,0.15);
        color: white;
        font-size: 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        transition: 0.3s;
        opacity: 0;
        visibility: hidden;
    }

        .btn-slide:hover {
            background: rgba(0,0,0,0.6);
        }

    #btn-prev-img {
        left: 10px;
    }

    #btn-next-img {
        right: 10px;
    }

    .image-slider-wrapper:hover .btn-slide {
        opacity: 1;
        visibility: visible;
    }

    .thumb-img {
        width: 70px;
        height: 70px;
        border: 1px solid #e5e7eb;
        cursor: pointer;
        border-radius: 8px;
        object-fit: contain;
        padding: 5px;
        background: #fff;
        transition: 0.2s;
    }

        .thumb-img:hover, .thumb-img.active {
            border: 2px solid #d70018;
        }

    .star-rating-interactive {
        direction: rtl;
        display: inline-flex;
        font-size: 2.5rem;
        justify-content: center;
    }

        .star-rating-interactive input[type="radio"] {
            display: none;
        }

        .star-rating-interactive label {
            color: #e4e5e9;
            cursor: pointer;
            transition: color 0.2s ease-in-out, transform 0.2s;
            padding: 0 5px;
        }

            .star-rating-interactive input[type="radio"]:checked ~ label, .star-rating-interactive label:hover, .star-rating-interactive label:hover ~ label {
                color: #ffc107;
            }

            .star-rating-interactive label:hover {
                transform: scale(1.2);
            }

    /* =======================================
       CSS LƯỚI 5 CỘT & THẺ SẢN PHẨM TƯƠNG TỰ
       ======================================= */
    .grid-5-cols {
        display: flex;
        flex-wrap: wrap;
        margin-left: -10px;
        margin-right: -10px;
        justify-content: center; /* KHI THIẾU SP NÓ SẼ GIÃN VÀO GIỮA */
    }

        /* Ép cứng cột 20% (100% / 5) */
        .grid-5-cols > .col-item {
            flex: 0 0 20%;
            max-width: 20%;
            padding-left: 10px;
            padding-right: 10px;
            margin-bottom: 20px;
        }

    /* CSS Cho thẻ Card của Sản Phẩm Tương Tự */
    .cps-card {
        background: #fff;
        border-radius: 10px;
        padding: 15px;
        border: 1px solid #f0f0f0;
        transition: all 0.3s ease;
        position: relative;
        box-shadow: 0 1px 4px rgba(0,0,0,0.05);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .cps-card:hover {
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            transform: translateY(-5px);
            border-color: #d70018;
        }

    .discount-badge {
        position: absolute;
        top: 10px;
        left: -5px;
        background: #d70018;
        color: #fff;
        font-weight: bold;
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 0 15px 15px 0;
        z-index: 2;
        box-shadow: 2px 2px 5px rgba(0,0,0,0.2);
    }

    .cps-card-img {
        text-align: center;
        margin-bottom: 15px;
    }

        /* Ép ảnh không bị tràn */
        .cps-card-img img {
            max-width: 100%;
            height: 180px;
            object-fit: contain;
            transition: transform 0.3s;
        }

    .cps-card:hover .cps-card-img img {
        transform: scale(1.05);
    }

    .cps-card-title {
        font-size: 14px;
        font-weight: 600;
        color: #333;
        text-decoration: none;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 10px;
        line-height: 1.4;
    }

        .cps-card-title:hover {
            color: #d70018;
        }

    .cps-price-box {
        margin-top: auto;
    }

    .cps-price-new {
        color: #d70018;
        font-size: 16px;
        font-weight: 700;
        display: block;
        margin-bottom: 2px;
    }

    .cps-price-old {
        color: #707070;
        font-size: 13px;
        text-decoration: line-through;
    }
    /* =======================================
       CSS ÉP KHUNG CHO NỘI DUNG CKEDITOR (MÔ TẢ SẢN PHẨM)
       ======================================= */
    .ckeditor-content {
        line-height: 1.8;
        font-size: 15px;
        color: #333;
        overflow: hidden; /* Tránh tràn ngang nếu admin dán chữ quá dài */
    }

        /* 1. Xử lý Ảnh trong bài viết (Cực kỳ quan trọng)
       Phải ép width 100% để ảnh to của Admin không làm vỡ giao diện web */
        .ckeditor-content img {
            max-width: 100% !important;
            height: auto !important;
            border-radius: 8px;
            margin: 15px 0;
            display: block; /* Bỏ khoảng trắng dư thừa dưới ảnh */
        }

        /* 2. Xử lý Bảng biểu (Tables) do admin vẽ */
        .ckeditor-content table {
            width: 100% !important;
            border-collapse: collapse;
            margin-bottom: 15px;
        }

        .ckeditor-content table, .ckeditor-content th, .ckeditor-content td {
            border: 1px solid #ddd;
        }

        .ckeditor-content th, .ckeditor-content td {
            padding: 8px 12px;
        }

        /* 3. Chỉnh lại khoảng cách các đoạn văn */
        .ckeditor-content p {
            margin-bottom: 15px;
        }

        /* 4. Định dạng lại danh sách (bullet points) */
        .ckeditor-content ul {
            list-style-type: disc;
            padding-left: 20px;
            margin-bottom: 15px;
        }

        .ckeditor-content ol {
            list-style-type: decimal;
            padding-left: 20px;
            margin-bottom: 15px;
        }
</style>

<div class="breadcrumb-area mt-10">
    <div class="container">
        <div class="breadcrumb">
            <ul class="d-flex align-items-center">
                <li>@Html.ActionLink("Trang chủ", "Index", "Home")</li>
                <li>@Html.ActionLink("Cửa hàng", "Shop", "Product")</li>
                <li class="active">@Model.TenSP</li>
            </ul>
        </div>
    </div>
</div>

<div class="main-product-thumbnail pb-100 pb-sm-60" style="padding-top: 30px;">
    <div class="container">
        <div class="thumb-bg">
            <div class="row">
                <div class="col-lg-5 mb-all-40">
                    <div class="tab-content position-relative image-slider-wrapper" style="border: 1px solid #e5e7eb; border-radius: 12px; background: #fff; overflow: hidden;">
                        <button id="btn-prev-img" class="btn-slide">‹</button>
                        <div id="thumb1" class="tab-pane fade show active text-center">
                            <a id="modal-a-hinhanh" data-fancybox="images" href="@Model.HinhAnh" class="d-flex align-items-center justify-content-center" style="height: 300px;">
                                <img id="modal-hinhanh" src="@Model.HinhAnh" alt="@Model.TenSP" style="width: 100%; height: 100%; max-height: 360px; object-fit: contain; border-radius: 8px; transition: 0.3s;">
                            </a>
                        </div>
                        <button id="btn-next-img" class="btn-slide">›</button>
                    </div>
                    <div id="gallery-container" class="mt-3 d-flex" style="gap: 10px; flex-wrap: wrap;"></div>
                </div>

                <div class="col-lg-7">
                    <div class="sticky-right-column">

                        <div class="thubnail-desc fix">
                            <h3 class="product-header" style="font-weight:bold; font-size:24px; margin-bottom: 5px;">@Model.TenSP</h3>
                            <p style="opacity: .8; font-weight: bold; color: #007bff;">Danh mục: @Model.DanhMuc.TenDM</p>
                        </div>

                        <div class="pro-price mtb-15 border-bottom pb-3" id="price-container">
                            <h3 id="hienThiGia" style="color:#d70018; font-weight:bold; display: flex; align-items: center; gap: 10px; margin:0;">
                                Đang tải giá...
                            </h3>
                        </div>

                        <div id="attributes-container" class="config-scroll-box">
                            <div id="box-chon-cauhinh"></div>
                        </div>

                        <p id="hienThiTonKho" style="font-weight: bold; margin-bottom: 10px;"></p>

                        <p style="font-size: 16px; font-weight: bold; margin-bottom:10px;">Số lượng:</p>
                        <div class="box-quantity d-flex align-items-center">
                            <form action="#" style="display:flex; height:45px; border: 1px solid #ccc; border-radius: 5px; overflow:hidden;">
                                <button type="button" class="qty-btn minus" style="background:#f3f4f6; color:#333; border:none; width:40px; font-size:18px;">-</button>
                                <input class="quantity font-weight-bold" id="modal-soluong" min="1" value="1" style="border:none; text-align:center; width:50px; outline:none;">
                                <button type="button" class="qty-btn plus" style="background:#f3f4f6; color:#333; border:none; width:40px; font-size:18px;">+</button>
                            </form>

                            <div class="pro-actions ml-3 w-100">
                                <button id="btn-add-cart" type="button" onclick="themVaoGioHang()" class="btn w-100 shadow-sm" style="height:45px; background:#d70018; color:white; font-weight:bold; font-size:16px; border-radius:5px;">
                                    THÊM VÀO GIỎ HÀNG
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="thumnail-desc pb-100 pb-sm-60 mt-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mb-all-40">
                <h4 style="font-weight:bold; text-transform:uppercase; margin-bottom:20px; border-bottom: 2px solid #d70018; display:inline-block; padding-bottom:5px;">Đặc điểm nổi bật</h4>

                <div class="ckeditor-content" style="background: #fff; padding: 25px; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.1);">
                    @if (Model.MoTa != null)
                    {
                        @Html.Raw(Model.MoTa)
                    }
                    else
                    {
                        <p class="text-muted text-center italic">Đang cập nhật mô tả...</p>
                    }
                </div>
            </div>

            <div class="col-lg-4">
                <div class="sticky-specs-sidebar">

                    <h4 style="font-weight:bold; text-transform:uppercase; margin-bottom:20px; border-bottom: 2px solid #d70018; display:inline-block; padding-bottom:5px;">Thông số kỹ thuật</h4>
                    <div style="background: #fff; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.1); overflow: hidden; margin-bottom: 20px;">
                        <table class="table mb-0 tech-specs-table">
                            <tbody>
                                @if (ViewBag.ThongSoKyThuat != null)
                                {
                                    var dictThongSo = ViewBag.ThongSoKyThuat as Dictionary<Maison.Models.ThuocTinh, List<Maison.Models.GiaTriTT>>;
                                    if (dictThongSo != null && dictThongSo.Count > 0)
                                    {
                                        foreach (var ts in dictThongSo)
                                        {
                                            <tr>
                                                <th>@ts.Key.TenTT</th>
                                                <td>
                                                    @foreach (var val in ts.Value)
                                                    {
                                                        <span>@val.GiaTri<br /></span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr><td colspan="2" class="text-center text-muted">Đang cập nhật thông số kỹ thuật...</td></tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <h4 style="font-weight:bold; text-transform:uppercase; margin-bottom:20px; border-bottom: 2px solid #d70018; display:inline-block; padding-bottom:5px;">Chính sách bán hàng</h4>
                    <div style="background: #fff; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.1); padding: 20px;">
                        <ul class="list-unstyled mb-0" style="font-size: 14px; line-height: 1.8;">
                            <li><i class="fas fa-check-circle text-success mr-2"></i> Cam kết hàng chính hãng 100%</li>
                            <li><i class="fas fa-shield-alt text-primary mr-2"></i> Bảo hành chính hãng @Model.ThoiHanBaoHanh tháng</li>
                            <li><i class="fas fa-sync-alt text-danger mr-2"></i> 1 đổi 1 trong 30 ngày nếu có lỗi NSX</li>
                            <li><i class="fas fa-truck text-info mr-2"></i> Giao hàng siêu tốc trong 2h</li>
                        </ul>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
<div class="block-title mt-2">
    <h2 class="font-weight-bold bg-danger d-inline text-light mb-2">Sản Phẩm Tương Tự</h2>
</div>

<hr />
    <br/>
<div class="grid-5-cols">

    @if (ViewBag.SanPhamTuongTu != null)
    {
        foreach (var spTuongTu in ViewBag.SanPhamTuongTu as List<Maison.Models.Sanpham>)
        {
            <div class="col-item">
                <div class="cps-card">
                    @{
                        decimal minGiaSauGiam = decimal.MaxValue;
                        decimal giaGocCuaBanReNhat = 0;
                        int phanTramHienThi = 0;

                        if (spTuongTu.BienThes != null && spTuongTu.BienThes.Any())
                        {
                            foreach (var bt in spTuongTu.BienThes)
                            {
                                var activeKMs = spTuongTu.SanPhamKhuyenMais != null
                                    ? spTuongTu.SanPhamKhuyenMais.Where(k => k.KhuyenMai != null && k.KhuyenMai.TrangThai == 1 && k.KhuyenMai.NgayBatDau <= DateTime.Now && k.KhuyenMai.NgayKetThuc >= DateTime.Now)
                                    : Enumerable.Empty<Maison.Models.SanPhamKhuyenMai>();

                                int maxRieng = activeKMs.Where(k => k.MaBT == bt.MaBT).Select(k => k.PhanTramGiam).DefaultIfEmpty(0).Max();
                                int maxChung = activeKMs.Where(k => k.MaBT == null).Select(k => k.PhanTramGiam).DefaultIfEmpty(0).Max();
                                int phanTram = Math.Max(maxRieng, maxChung);

                                decimal giaSauGiam = bt.GiaBan * (1 - (decimal)phanTram / 100);

                                if (giaSauGiam < minGiaSauGiam)
                                {
                                    minGiaSauGiam = giaSauGiam;
                                    giaGocCuaBanReNhat = bt.GiaBan;
                                    phanTramHienThi = phanTram;
                                }
                            }
                        }

                        // ============================================================
                        // LỌC TAG THÔNG SỐ: Xóa trùng lặp và Xếp chuẩn từ 0, 1, 2...
                        // ============================================================
                        // Đặt đoạn này vào chỗ khai báo cacTagThongSo ngoài View:
                        // ghep day
                        var cacTagThongSo = spTuongTu.BienThes != null ? spTuongTu.BienThes
                            .SelectMany(b => b.ChiTietBTs)
                            .Where(c => c.GiaTriTT != null && c.GiaTriTT.ThuocTinh != null && c.GiaTriTT.ThuocTinh.LaThuocTinhChinh == true)
                            .GroupBy(c => c.GiaTriTT.GiaTri)
                            .Select(g => g.First())
                            .OrderBy(c => c.GiaTriTT.ThuocTinh.ThuTuHienThi) // Sắp xếp chuẩn 0, 1, 2...
                            .Select(c => c.GiaTriTT.GiaTri)
                            .ToList() : new List<string>();
                    }

                    @if (phanTramHienThi > 0)
                    {
                        <div class="discount-badge">Giảm @phanTramHienThi%</div>
                    }

                    <a href="@Url.Action("ProductDetail", "Product", new { id = spTuongTu.MaSP })" class="cps-card-img">
                        <img src="@spTuongTu.HinhAnh" onerror="this.src='/Content/Images/no-image.png'" alt="@spTuongTu.TenSP" />
                    </a>

                    <a href="@Url.Action("ProductDetail", "Product", new { id = spTuongTu.MaSP })" class="cps-card-title">
                        @spTuongTu.TenSP
                    </a>

                    <div class="cps-price-box">
                        @if (minGiaSauGiam != decimal.MaxValue)
                        {
                            <span class="cps-price-new">@string.Format(info, "{0:c0}", minGiaSauGiam)</span>
                            if (phanTramHienThi > 0)
                            {
                                <span class="cps-price-old">@string.Format(info, "{0:c0}", giaGocCuaBanReNhat)</span>
                            }
                        }
                        else
                        {
                            <span class="cps-price-new text-muted" style="font-size:14px;">Đang cập nhật giá</span>
                        }
                    </div>
                    @*//ghep day*@
                    @if (cacTagThongSo.Any())
                    {
                        <div class="variant-tags mt-2" style="display: flex; flex-wrap: wrap; gap: 5px;">
                            @foreach (var tag in cacTagThongSo)
                            {
                                <span class="v-tag" style="font-size: 11px; color: #555; background: #f3f4f6; padding: 3px 6px; border: 1px solid #e5e7eb; border-radius: 4px;">
                                    @tag
                                </span>
                            }
                        </div>
                    }

                </div>
            </div>
        }
    }
</div>

<div class="text-center mt-5 mb-4">
    <button id="btn-show-form" class="btn" style="background: #28a745; color: white; font-weight: bold; padding: 10px 25px; border-radius: 30px; box-shadow: 0 4px 6px rgba(40,167,69,0.3); transition: 0.3s;">
        <i class="fas fa-pencil-alt mr-2"></i> Viết đánh giá của bạn
    </button>
</div>

<div id="form-danhgia" style="display:none; max-width: 650px; margin: 0 auto; background: #fff; border: 1px solid #eaeaea; border-radius: 12px; padding: 30px; margin-bottom: 40px; box-shadow: 0 10px 25px rgba(0,0,0,0.08);">
    @if (Session[Maison.Session.ConstaintUser.USER_SESSION] != null)
    {
        <h4 class="font-weight-bold text-center mb-2" style="color: #333;">Đánh giá sản phẩm</h4>
        <p class="text-center text-muted mb-4">Chia sẻ trải nghiệm của bạn để giúp những người mua khác nhé!</p>

        <div class="form-group text-center border-bottom pb-4 mb-4">
            <label class="font-weight-bold d-block text-uppercase" style="color: #555; letter-spacing: 1px;">Chất lượng sản phẩm</label>
            <div class="star-rating-interactive mt-2">
                <input type="radio" id="star5" name="dg-xepHang" value="5" checked /><label for="star5" title="5 sao - Tuyệt vời"><i class="fas fa-star"></i></label>
                <input type="radio" id="star4" name="dg-xepHang" value="4" /><label for="star4" title="4 sao - Rất tốt"><i class="fas fa-star"></i></label>
                <input type="radio" id="star3" name="dg-xepHang" value="3" /><label for="star3" title="3 sao - Bình thường"><i class="fas fa-star"></i></label>
                <input type="radio" id="star2" name="dg-xepHang" value="2" /><label for="star2" title="2 sao - Tạm được"><i class="fas fa-star"></i></label>
                <input type="radio" id="star1" name="dg-xepHang" value="1" /><label for="star1" title="1 sao - Rất tệ"><i class="fas fa-star"></i></label>
            </div>
        </div>

        <div class="form-group mb-4">
            <label class="font-weight-bold" style="color: #444;">Nội dung đánh giá <span class="text-danger">*</span></label>
            <textarea id="dg-binhLuan" class="form-control bg-light" rows="4" placeholder="Hãy chia sẻ những điều bạn thích hoặc không thích về sản phẩm này..." style="border-radius: 8px; border: 1px solid #ddd;"></textarea>
        </div>

        <div class="form-group mb-4 p-3" style="background: #f8f9fa; border-radius: 8px; border: 1px dashed #ccc;">
            <label class="font-weight-bold mb-2"><i class="fas fa-camera text-secondary mr-2"></i>Thêm ảnh thực tế (Tùy chọn):</label>
            <input type="file" id="dg-hinhanh" class="form-control-file mt-1" accept="image/*" />
        </div>

        <button id="btnGuiDanhGia" class="btn btn-danger btn-block font-weight-bold" style="border-radius: 8px; padding: 14px; font-size: 16px; letter-spacing: 1px;">
            GỬI ĐÁNH GIÁ NGAY
        </button>
    }
    else
    {
        <div class="text-center py-5">
            <div class="mb-3"><i class="fas fa-user-lock fa-4x text-muted opacity-50"></i></div>
            <h5 class="font-weight-bold text-dark">Chỉ khách hàng mới có thể đánh giá</h5>
            <p class="text-muted mb-4">Vui lòng đăng nhập để chia sẻ cảm nhận của bạn về sản phẩm.</p>
            <a href="@Url.Action("Login", "Home")" class="btn btn-primary px-5 py-2 rounded-pill font-weight-bold shadow-sm">Đăng nhập ngay</a>
        </div>
    }
</div>

<div id="danh-sach-danhgia">
    @Html.Action("DanhSachTheoSP", "DanhGia", new { maSP = Model.MaSP })
</div>

@section Script {
    <script>
        const DSNguonBienThe = @Html.Raw(ViewBag.BienThes_Json);
        const DSThuocTinh = @Html.Raw(ViewBag.ThuocTinhCauHinh_Json); // Dữ liệu cấu trúc ma trận
        const TEN_SAN_PHAM = "@Html.Raw(Model.TenSP)";
        const formatter = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' });

        let selectedMaBT = null;
        let currentImages = [];
        let currentIndex = 0;
        let luaChonHienTai = {}; // Lưu trữ: { MaTT_1: MaGT_5, MaTT_2: MaGT_8 }

        $(document).ready(function () {
            // ========================================================
            // BƯỚC MỚI: TỰ ĐỘNG CHỌN SẴN CẤU HÌNH MẶC ĐỊNH (CÓ THẬT)
            // ========================================================
            if (DSNguonBienThe && DSNguonBienThe.length > 0) {
                // Ưu tiên bốc bản rẻ nhất ra làm mặc định để khách thấy giá ngon
                let banMacDinh = DSNguonBienThe.reduce((prev, curr) => {
                    let giaPrev = prev.GiaBan * (1 - (prev.PhanTramGiam / 100));
                    let giaCurr = curr.GiaBan * (1 - (curr.PhanTramGiam / 100));
                    return giaCurr < giaPrev ? curr : prev;
                });

                // Phân tích bản mặc định này đang chứa những Mã Giá Trị (MaGT) nào, rồi tick chọn cho khách luôn
                DSThuocTinh.forEach(tt => {
                    let matchedGT = tt.GiaTris.find(gt => banMacDinh.ChiTiets.includes(gt.MaGT));
                    if (matchedGT) {
                        luaChonHienTai[tt.MaTT] = matchedGT.MaGT;
                    }
                });
            }

            // Khởi tạo giao diện lần đầu (Sẽ in ra cấu hình mặc định vừa chọn ở trên)
            renderCauHinh();

            // Xử lý tăng giảm số lượng
            $(".qty-btn.minus").click(function () {
                let v = parseInt($("#modal-soluong").val());
                if (v > 1) $("#modal-soluong").val(v - 1);
            });
            $(".qty-btn.plus").click(function () {
                let v = parseInt($("#modal-soluong").val());
                $("#modal-soluong").val(v + 1);
            });

            // Xử lý mở form đánh giá
            $('#btn-show-form').click(function () {
                $('#form-danhgia').slideToggle(300);
                $(this).html(function (i, html) {
                    return html.includes('Viết đánh giá')
                        ? '<i class="fas fa-times mr-2"></i> Hủy đánh giá'
                        : '<i class="fas fa-pencil-alt mr-2"></i> Viết đánh giá của bạn';
                });
                $(this).toggleClass("btn-danger btn-success");
            });

            // ... (Giữ nguyên đoạn AJAX gửi Form Đánh Giá ở đây nếu bạn muốn) ...
        });

        // ========================================================
        // THUẬT TOÁN 1: VẼ CÁC NÚT BẤM DỰA VÀO LỰA CHỌN HIỆN TẠI
        // ========================================================
        function renderCauHinh() {
            let html = '';

            // DSThuocTinh đã được C# sắp xếp chuẩn theo ThuTuHienThi từ trên xuống
            DSThuocTinh.forEach((tt, index) => {
                html += `<div style="font-size: 13px; font-weight: 700; margin-bottom: 6px; color: #555; text-transform: uppercase;">${tt.TenTT}</div>`;
                html += `<div class="d-flex flex-wrap mb-3">`;

                // LOGIC THỨ TỰ: Nhóm này chỉ được mở khóa NẾU nó là nhóm đầu tiên (index = 0)
                // HOẶC nhóm liền trước nó (index - 1) đã được người dùng tick chọn.
                let choPhepChon = true;
                if (index > 0) {
                    let thuocTinhTruocDo = DSThuocTinh[index - 1];
                    if (!luaChonHienTai[thuocTinhTruocDo.MaTT]) {
                        choPhepChon = false; // Bị khóa vì bước trước chưa chọn
                    }
                }

                tt.GiaTris.forEach(gt => {
                    let activeClass = luaChonHienTai[tt.MaTT] === gt.MaGT ? "active" : "";

                    // Nút chỉ hợp lệ nếu Nhóm được mở khóa VÀ cấu hình này có tồn tại thật
                    let hopLe = choPhepChon ? checkHopLe(tt.MaTT, gt.MaGT) : false;
                    let disabledClass = hopLe ? "" : "disabled-variant";

                    html += `<div class="variant-box ${activeClass} ${disabledClass}"
                                  onclick="chonGiaTri(${tt.MaTT}, ${gt.MaGT}, ${hopLe}, ${index})">
                                ${gt.GiaTri}
                             </div>`;
                });
                html += `</div>`;
            });

            $("#box-chon-cauhinh").html(html);
            kiemTraChotCauHinh();
        }

        // ========================================================
        // THUẬT TOÁN 2: KIỂM TRA TÍNH HỢP LỆ KHI LỌC CHÉO
        // ========================================================
        function checkHopLe(maTT, maGT) {
            let tempSelection = { ...luaChonHienTai };
            tempSelection[maTT] = maGT;

            return DSNguonBienThe.some(bt => {
                for (let keyTT in tempSelection) {
                    let requiredMaGT = tempSelection[keyTT];
                    if (requiredMaGT && !bt.ChiTiets.includes(requiredMaGT)) {
                        return false;
                    }
                }
                return true;
            });
        }

        // ========================================================
        // SỰ KIỆN: KHI KHÁCH HÀNG BẤM VÀO 1 Ô THÔNG SỐ
        // ========================================================
        function chonGiaTri(maTT, maGT, hopLe, currentIndex) {
            if (!hopLe) return; // Nút mờ thì cấm bấm

            if (luaChonHienTai[maTT] === maGT) {
                // HỦY CHỌN: Nếu bấm bỏ chọn bước này, phải xóa sạch DỮ LIỆU CỦA NÓ VÀ TẤT CẢ CÁC BƯỚC SAU NÓ
                for (let i = currentIndex; i < DSThuocTinh.length; i++) {
                    delete luaChonHienTai[DSThuocTinh[i].MaTT];
                }
            } else {
                // CHỌN MỚI: Ghi nhận bước này, VÀ XÓA SẠCH CÁC BƯỚC SAU NÓ (bắt khách chọn lại nhánh mới)
                luaChonHienTai[maTT] = maGT;
                for (let i = currentIndex + 1; i < DSThuocTinh.length; i++) {
                    delete luaChonHienTai[DSThuocTinh[i].MaTT];
                }
            }

            renderCauHinh();
        }

        // ========================================================
        // BƯỚC CUỐI: TÌM GIÁ TIỀN & XÁC NHẬN selectedMaBT
        // ========================================================
        function kiemTraChotCauHinh() {
            let btnCart = $("#btn-add-cart");
            let soNhomCanChon = DSThuocTinh.length;
            let soNhomDaChon = Object.keys(luaChonHienTai).length;

            if (soNhomDaChon < soNhomCanChon) {
                selectedMaBT = null; // Trả về rỗng để chặn mua hàng
                $("#hienThiGia").html(`<span style="font-size:20px; color:#555;">Vui lòng chọn cấu hình để xem giá</span>`);
                $("#hienThiTonKho").text("");
                btnCart.text("CHỌN CẤU HÌNH").attr("disabled", "disabled").css("background", "#6c757d");
                return;
            }

            let matchedBT = DSNguonBienThe.find(bt => {
                for (let key in luaChonHienTai) {
                    if (!bt.ChiTiets.includes(luaChonHienTai[key])) return false;
                }
                return true;
            });

            if (matchedBT) {
                selectedMaBT = matchedBT.MaBT; // CHỐT ID MUA HÀNG
                let giaBan = matchedBT.GiaBan;
                let phanTramGiam = matchedBT.PhanTramGiam;

                // Đổi tiêu đề form Đánh giá
                let tenCauHinh = DSThuocTinh.map(tt => tt.GiaTris.find(gt => gt.MaGT === luaChonHienTai[tt.MaTT])?.GiaTri).join(' - ');
                $("#dynamic-review-title").text("Đánh giá " + TEN_SAN_PHAM + " | " + tenCauHinh);

                if (phanTramGiam > 0) {
                    let giaGiam = giaBan * (1 - phanTramGiam / 100);
                    $("#hienThiGia").html(`
                        <span style="font-size:28px;">${formatter.format(giaGiam)}</span>
                        <del style="color:gray; font-size:16px; font-weight:normal;">${formatter.format(giaBan)}</del>
                        <span class="badge badge-danger" style="font-size:14px; padding: 5px 10px;">Giảm ${phanTramGiam}%</span>
                    `);
                } else {
                    $("#hienThiGia").html(`<span style="font-size:28px;">${formatter.format(giaBan)}</span>`);
                }

                if (matchedBT.SoLuongTon > 0) {
                    $("#hienThiTonKho").text("✓ Còn hàng (" + matchedBT.SoLuongTon + " sản phẩm)").css("color", "#28a745");
                    btnCart.text("THÊM VÀO GIỎ HÀNG").removeAttr("disabled").css("background", "#d70018");
                } else {
                    $("#hienThiTonKho").text("✕ Tạm hết hàng").css("color", "#dc3545");
                    btnCart.text("TẠM HẾT HÀNG").attr("disabled", "disabled").css("background", "#6c757d");
                }

                updateGallery(matchedBT.HinhAnh, matchedBT.ThuVienAnhs);
            }
        }

        // ========================================================
        // HÀM MỚI: THÊM VÀO GIỎ HÀNG (ĐÃ SỬA LẠI ĐÚNG BIẾN AJAX)
        // ========================================================
        function themVaoGioHang() {
            // Lấy ID cấu hình từ thuật toán ở trên
            let mabt = selectedMaBT;
            let soluong = parseInt($("#modal-soluong").val()) || 1;

            if (!mabt || mabt == 0) {
                swal("Thất bại!", "Vui lòng chọn đầy đủ cấu hình sản phẩm trước khi thêm vào giỏ.", "warning");
                return;
            }

            // Gửi dữ liệu đúng Format mong muốn của CartController (mabt, soluongmua)
            $.ajax({
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ "mabt": mabt, "soluongmua": soluong }),
                url: '/Cart/AddToCart',
                success: function (response) {
                    if (response.notLoggedIn) {
                        swal({
                            title: "Chưa đăng nhập!",
                            text: response.message,
                            icon: "warning",
                            buttons: ["Hủy", "Đăng nhập ngay"],
                        }).then((willLogin) => {
                            if (willLogin) { window.location.href = "/Home/Login"; }
                        });
                        return;
                    }

                    if (!response.status) {
                        swal("Thất bại!", response.message, "error");
                    } else {
                        if ($("#product-count").length) {
                            $("#product-count").html(response.cartCount);
                        }
                        swal("Thành công!", "Sản phẩm đã được thêm vào giỏ hàng nhé <3", "success");
                    }
                },
                error: function () { swal("Lỗi!", "Đã xảy ra lỗi hệ thống..", "error"); }
            });
        }

        // Slider ảnh
        function updateGallery(mainImg, arrGallery) {
            $("#modal-hinhanh").attr("src", mainImg);
            $("#modal-a-hinhanh").attr("href", mainImg);
            currentImages = [mainImg, ...arrGallery];
            currentIndex = 0;

            let html = "";
            currentImages.forEach((img, idx) => {
                let activeClass = (idx === 0) ? "active" : "";
                html += `<img src="${img}" class="thumb-img ${activeClass}" onclick="loadSlide(${idx})">`;
            });
            $("#gallery-container").html(html);
        }
        function loadSlide(index) {
            if (index < 0) index = currentImages.length - 1;
            if (index >= currentImages.length) index = 0;
            currentIndex = index;
            $("#modal-hinhanh").attr("src", currentImages[currentIndex]);
            $("#modal-a-hinhanh").attr("href", currentImages[currentIndex]);
            $(".thumb-img").removeClass("active");
            $(".thumb-img").eq(currentIndex).addClass("active");
        }
        $("#btn-prev-img").click(() => loadSlide(currentIndex - 1));
        $("#btn-next-img").click(() => loadSlide(currentIndex + 1));


        // XỬ LÝ GỬI ĐÁNH GIÁ
    $('#btnGuiDanhGia').click(function (e) {
        e.preventDefault();

        var maBT = selectedMaBT;
        if (!maBT) {
            Swal.fire('Chú ý', 'Vui lòng chọn một cấu hình sản phẩm ở trên trước khi đánh giá.', 'warning');
            return;
        }

        var binhLuan = $('#dg-binhLuan').val().trim();
        var xepHang = $('input[name="dg-xepHang"]:checked').val();
        var fileAnh = $('#dg-hinhanh')[0].files[0];

        if (binhLuan.length === 0) {
            Swal.fire('Thiếu thông tin', 'Vui lòng nhập nội dung đánh giá của bạn.', 'warning');
            $('#dg-binhLuan').focus();
            return;
        }

        var formData = new FormData();
        formData.append("maBT", maBT);
        formData.append("xepHang", xepHang);
        formData.append("binhLuan", binhLuan);
        if (fileAnh) {
            formData.append("imageFile", fileAnh);
        }

        Swal.fire({ title: 'Đang tải lên...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });

        $.ajax({
            url: '/DanhGia/ThemDanhGia',
            type: 'POST',
            data: formData,
            contentType: false,
            processData: false,
            success: function (res) {
                if (res.success) {
                    Swal.fire('Thành công', res.message, 'success').then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire('Lỗi', res.message, 'error');
                }
            },
            error: function () {
                Swal.fire('Lỗi', 'Mất kết nối mạng, vui lòng thử lại.', 'error');
            }
        });
    });

    </script>
}