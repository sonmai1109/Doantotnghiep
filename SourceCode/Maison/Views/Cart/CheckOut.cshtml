@using Maison.Models
@model List<Maison.Models.GioHang>
@{
    ViewBag.Title = "Đặt hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var info = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
    Decimal tongtien = 0;

    // Tương tự, lấy giá đã giảm từ Controller
    var dicGia = ViewBag.DicGia as Dictionary<int, decimal>;
}

<div class="breadcrumb-area mt-30">
    <div class="container">
        <div class="breadcrumb">
            <ul class="d-flex align-items-center">
                <li>@Html.ActionLink("Trang chủ", "Index", "Home")</li>
                <li class="active">@Html.ActionLink("Đặt hàng", "CheckOut", "Cart")</li>
            </ul>
        </div>
    </div>
</div>

<div class="checkout-area pb-100 pt-15 pb-sm-60">
    <div class="container">
        <div class="row">
            <form class="col-lg-6 col-md-6" id="add-bill-form" onsubmit="return datHang(event)">
                <div class="checkbox-form mb-sm-40 border p-4 bg-light rounded">
                    <h3 class="font-weight-bold mb-4">Thông tin nhận hàng</h3>
                    <input type="hidden" name="matk" value="@ViewBag.TaiKhoan.MaTK" />

                    <div class="row">
                        <div class="col-md-12 mb-3">
                            <label class="font-weight-bold">Họ tên <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" required name="hotennguoinhan" value="@ViewBag.TaiKhoan.HoTen" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="font-weight-bold">Số điện thoại <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" required name="sodienthoainhan" value="@ViewBag.TaiKhoan.SoDienThoai" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="font-weight-bold">Địa chỉ nhận hàng <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="diachinhan" required value="@ViewBag.TaiKhoan.DiaChi" />
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="font-weight-bold">Ghi chú đơn hàng (Tùy chọn)</label>
                            <textarea class="form-control" name="ghichu" rows="4" placeholder="Vd: Giao giờ hành chính"></textarea>
                        </div>
                    </div>
                </div>
            </form>

            <div class="col-lg-6 col-md-6">
                <div class="your-order border p-4 rounded bg-white shadow-sm">
                    <h3 class="font-weight-bold mb-4">Tóm tắt đơn hàng</h3>
                    <div class="your-order-table table-responsive">
                        <table class="table">
                            <thead class="bg-light">
                                <tr>
                                    <th class="product-name">Sản phẩm</th>
                                    <th class="product-total text-right">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var gh in Model)
                                {
                                    var bt = gh.BienThe;
                                    var donGia = dicGia != null && dicGia.ContainsKey(gh.MaGH) ? dicGia[gh.MaGH] : bt.GiaBan;
                                    var soLuong = gh.SoLuong;

                                    <tr class="cart_item">
                                        <td class="product-name">
                                            <strong>@bt.Sanpham.TenSP</strong>

                                            @{
                                                // LỌC THÔNG SỐ CHÍNH VÀ XẾP ĐÚNG THỨ TỰ (0, 1, 2...)
                                                var cacThongSoChinh = bt.ChiTietBTs
                                                    .Where(c => c.GiaTriTT != null && c.GiaTriTT.ThuocTinh != null && c.GiaTriTT.ThuocTinh.LaThuocTinhChinh == true)
                                                    .OrderBy(c => c.GiaTriTT.ThuocTinh.ThuTuHienThi)
                                                    .Select(c => c.GiaTriTT.GiaTri)
                                                    .ToList();

                                                string chuoiThongSo = cacThongSoChinh.Any() ? string.Join(" - ", cacThongSoChinh) : "Bản tiêu chuẩn";
                                            }

                                            <br /><small class="text-muted">(@chuoiThongSo)</small>
                                            <strong class="product-quantity text-danger ml-2">x @soLuong</strong>
                                        </td>
                                        <td class="product-total text-right align-middle">
                                            <span class="amount font-weight-bold">@(string.Format(info,"{0:c0}", donGia * soLuong))</span>
                                        </td>
                                    </tr>
                                    tongtien += donGia * soLuong;
                                }
                            </tbody>
                            <tfoot>
                                <tr class="order-total" style="font-size: 18px; border-top: 2px solid #ddd;">
                                    <th class="py-3">Cần thanh toán</th>
                                    <td class="text-right py-3">
                                        <strong><span class="amount text-danger" id="order-total">@(string.Format(info, "{0:c0}", tongtien))</span></strong>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <h5 class="font-weight-bold mb-3 mt-4 text-uppercase">Phương thức thanh toán</h5>
                    <div class="payment-method-box mb-4">
                        <div class="custom-control custom-radio mb-3 p-3 border rounded bg-white shadow-sm">
                            <input type="radio" id="pay-cod" name="PhuongThuc" value="COD" class="custom-control-input" checked>
                            <label class="custom-control-label font-weight-bold" for="pay-cod" style="cursor:pointer; padding-top: 2px;">
                                <i class="fas fa-money-bill-wave text-success mr-2"></i> Thanh toán khi nhận hàng (COD)
                            </label>
                        </div>
                        <div class="custom-control custom-radio p-3 border rounded bg-white shadow-sm">
                            <input type="radio" id="pay-qr" name="PhuongThuc" value="QR" class="custom-control-input">
                            <label class="custom-control-label font-weight-bold" for="pay-qr" style="cursor:pointer; padding-top: 2px;">
                                <i class="fas fa-qrcode text-danger mr-2"></i> Chuyển khoản ngân hàng qua mã QR
                            </label>
                        </div>
                    </div>

                    <div class="wc-proceed-to-checkout">
                        <button type="submit" form="add-bill-form" class="btn btn-danger btn-block font-weight-bold py-3 mt-3" style="font-size: 16px;">XÁC NHẬN ĐẶT HÀNG</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Script {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function datHang(e) {
            e.preventDefault();
            let formData = new FormData(document.getElementById("add-bill-form"));
            let phuongThuc = $("input[name='PhuongThuc']:checked").val();

            // THÊM DÒNG NÀY: Ép thêm cái Phương thức vào gói hàng để gửi lên C#
            formData.append("PhuongThuc", phuongThuc);

            Swal.fire({ title: 'Đang tạo đơn hàng...', allowOutsideClick: false, didOpen: () => { Swal.showLoading() } });

            $.ajax({
                url: '/Bill/CreateBill',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res.status == true) {
                        // NẾU LÀ MÃ QR -> CHUYỂN HƯỚNG SANG TRANG QR
                        if (phuongThuc === "QR") {
                            window.location.href = '/Bill/PaymentQR/' + res.billid;
                        }
        // ... code cũ bên dưới giữ nguyên
                        // NẾU LÀ COD -> BÁO THÀNH CÔNG VÀ VỀ TRANG CHI TIẾT
                        else {
                            Swal.fire({
                                icon: 'success',
                                title: 'Đặt hàng thành công!',
                                text: 'Đơn hàng của bạn đang chờ xử lý.',
                                showConfirmButton: false,
                                timer: 2000
                            }).then(() => {
                                window.location.href = '/Bill/Details/' + res.billid;
                            });
                        }
                    } else {
                        Swal.fire('Lỗi đặt hàng', res.message, 'error');
                    }
                }
            });
            return false;
        }
    </script>
}