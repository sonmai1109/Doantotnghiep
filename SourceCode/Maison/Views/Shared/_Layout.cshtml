<body>
    <header>
        <div class="headfrs text-center">
            <p><span class="dot"> </span> Happy New Year -Vui Tết Tràn Ngập!</p>

        </div>

        <div class="headersc">

            <div class="container">
                <div class="d-flex align-items-center gap-3">

                    <div class="logo">
                        <a href="/Home/Index"><img src="~/Content/client/img/lg.png" /></a>
                    </div>

                    <div class="menu-wrapper">
                        <button class="btn btn-light" id="buttondropmenu"> Danh Mục</button>
                        <ul class="border bg-white text-center dropmenu" id="dropmenu">@{Html.RenderAction("dropdanhmuc", "Home");}</ul>
                    </div>
                    <div class="flex-grow-1 position-relative">
                        <div class="input-group">
                            <span class="input-group-text bg-white">
                                <i class="fas fa-search "></i>
                            </span>
                            <input type="text"
                                   id="live-search-input"
                                   class="form-control"
                                   placeholder="Bạn muốn tìm gì?">
                        </div>

                        <div id="search-results-container" class="position-absolute bg-white border rounded shadow-sm w-100"
                             style="display: none; z-index: 1000; top: 100%; max-height: 400px; overflow-y: auto;">
                        </div>
                    </div>
                    @{ Html.RenderAction("CartCount", "Home"); }
                    @{ if (tk == null)
                        {
                            <div class="btn btn-light" id="clicktk">
                                <i class="nav-icon fas fa-user"></i>

                                Tài khoản
                            </div>
                            <div class="container text-center   pt-5  checktk border" id="checktk">

                                <h3>Bạn đã có tài khoản chưa?</h3>
                                <img src="~/Content/client/img/lg.png" width="120" height="100" class="d-block mx-auto mb-3" />
                                <p class="text-uppercase fw-bold mb-2">Vui lòng đăng nhập tài khoản để xem ưu đãi và thanh toán dễ dàng hơn.</p>


                                <div class="btn btn-primary fw-bold">@Html.ActionLink("Đăng nhập", "Login", "Home", null, new { @class = "text-light    text-decoration-none" })</div>
                                <div class="btn btn-danger fw-bold">@Html.ActionLink("Đăng ký", "Signup", "Home", null, new { @class = "text-light text-decoration-none" })</div>
                            </div>




                        }
                        else
                        {



                            <div class="user-box">
                                <div class="btn btn-danger p-2 clicktk2" id="clicktk2">
                                    <i class="nav-icon fas fa-user"></i>
                                    @tk.TenDangNhap
                                </div>

                                <div class="card text-center rounded-4 shadow checktk2" id="checktk2">
                                    @Html.ActionLink("Đơn Hàng Của Bạn", "ListBills", "Bill", null, new { @class = "text-dark text-decoration-none d-block p-2" })
                                    @Html.ActionLink("Đổi Mật Khẩu", "ChangePassWord", "AccountUser", null, new { @class = "text-dark text-decoration-none d-block p-2" })
                                    @Html.ActionLink("Thông Tin Tài Khoản", "UserInfor", "AccountUser", null, new { @class = "text-dark text-decoration-none d-block p-2" })
                                    @Html.ActionLink("Tra cứu bảo hành", "MyWarranties", "BaoHanh", null, new { @class = "text-dark text-decoration-none d-block p-2" })
                                    @Html.ActionLink("Đăng Xuất", "Logout", "Home", null, new { @class = "text-dark text-decoration-none d-block p-2" })

                                </div>
                            </div>

                        }

                    }


                    <a href="#" class="btn btn-light">
                        <i class="fas fa-phone text-danger"></i>  Liên hệ
                    </a>
                </div>

            </div>

        </div>

    </header>


