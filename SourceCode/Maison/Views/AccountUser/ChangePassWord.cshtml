@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-area mt-30 mb-30">
    <div class="container">
        <div class="breadcrumb">
            <ul class="d-flex align-items-center">
                <li>@Html.ActionLink("Trang chủ", "Index", "Home")</li>
                <li class="active">Đổi mật khẩu</li>
            </ul>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom-0">
                    <h4 class="mb-0 font-weight-bold text-danger"><i class="fas fa-lock mr-2"></i> Thay Đổi Mật Khẩu</h4>
                </div>
                <div class="card-body px-5 pb-5">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle mr-2"></i> @TempData["SuccessMessage"]
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                    }

                    @Html.ValidationMessage("ErrorUpdate", new { @class = "alert alert-danger d-block p-2 text-center", @id = "error-message" })

                    @using (Html.BeginForm("ChangePassWord", "AccountUser", FormMethod.Post, new { onsubmit = "return checkPass();" }))
                    {
                        <div class="form-group mb-3">
                            <label class="font-weight-bold text-dark">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                            <input type="password" name="oldpassword" id="oldpassword" class="form-control bg-light" required placeholder="Nhập mật khẩu cũ..." autocomplete="new-password">
                        </div>

                        <div class="form-group mb-3">
                            <label class="font-weight-bold text-dark">Mật khẩu mới <span class="text-danger">*</span></label>
                            <input type="password" name="password" id="password" class="form-control bg-light" required placeholder="Nhập mật khẩu mới..." autocomplete="new-password">
                        </div>

                        <div class="form-group mb-4">
                            <label class="font-weight-bold text-dark">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                            <input type="password" name="confirmpassword" id="confirmpassword" class="form-control bg-light" required placeholder="Nhập lại mật khẩu mới..." autocomplete="new-password">
                            <small id="password-match-msg" class="text-danger d-none mt-1"><i class="fas fa-times-circle"></i> Mật khẩu không khớp!</small>
                        </div>

                        <button type="submit" class="btn btn-danger btn-block font-weight-bold py-2 rounded-pill shadow-sm">XÁC NHẬN ĐỔI</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Script {
    <script>
        function checkPass() {
            var pass = document.getElementById("password").value;
            var confirmPass = document.getElementById("confirmpassword").value;

            if (pass !== confirmPass) {
                document.getElementById("password-match-msg").classList.remove("d-none");
                return false;
            }

            document.getElementById("password-match-msg").classList.add("d-none");
            return true;
        }

        // Tự động kiểm tra lúc đang gõ (UX xịn xò)
        document.getElementById("confirmpassword").addEventListener("input", function() {
            var pass = document.getElementById("password").value;
            if (this.value !== pass && this.value !== "") {
                document.getElementById("password-match-msg").classList.remove("d-none");
            } else {
                document.getElementById("password-match-msg").classList.add("d-none");
            }
        });
    </script>
}