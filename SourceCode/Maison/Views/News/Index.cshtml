@model PagedList.IPagedList<Maison.Models.TinTuc>
@using PagedList.Mvc

@{
    ViewBag.Title = "Tin tức Công nghệ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var info = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<style>
    /* CSS Riêng cho trang Danh sách Tin tức */
    .news-page-title {
        font-size: 28px;
        font-weight: 800;
        text-transform: uppercase;
        border-left: 5px solid #d70018;
        padding-left: 15px;
        margin-bottom: 30px;
        color: #333;
    }

    .news-list-card {
        display: flex;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        margin-bottom: 25px;
        transition: all 0.3s ease;
        text-decoration: none !important;
        border: 1px solid #f0f0f0;
    }

    .news-list-card:hover {
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        transform: translateY(-3px);
        border-color: #d70018;
    }

    .news-list-img {
        width: 35%;
        position: relative;
        overflow: hidden;
    }

    .news-list-img img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        position: absolute;
        transition: transform 0.5s ease;
    }

    .news-list-card:hover .news-list-img img {
        transform: scale(1.05);
    }

    .news-list-content {
        width: 65%;
        padding: 20px 25px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .news-list-title {
        font-size: 20px;
        font-weight: bold;
        color: #222;
        margin-bottom: 10px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        transition: color 0.2s;
    }

    .news-list-card:hover .news-list-title {
        color: #d70018;
    }

    .news-list-meta {
        font-size: 13px;
        color: #888;
        margin-bottom: 12px;
    }

    .news-list-summary {
        font-size: 14px;
        color: #555;
        line-height: 1.6;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Reponsive cho Mobile: Đổi từ dàn ngang sang dọc */
   
    
</style>

<div class="breadcrumb-area mt-30 mb-40">
    <div class="container">
        <div class="breadcrumb">
            <ul class="d-flex align-items-center">
                <li>@Html.ActionLink("Trang chủ", "Index", "Home")</li>
                <li class="active">Tin Công Nghệ 24h</li>
            </ul>
        </div>
    </div>
</div>

<div class="container mb-5">
    <h1 class="news-page-title">Tin Công Nghệ 24h</h1>

    <div class="row">
        <div class="col-lg-9 col-md-12">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <a href="@Url.Action("Details", "News", new { id = item.MaTin })" class="news-list-card">
                        <div class="news-list-img">
                            <img src="@item.AnhDaiDien" onerror="this.src='/Content/Images/no-image.png'" alt="@item.TieuDe">
                        </div>
                        <div class="news-list-content">
                            <h3 class="news-list-title">@item.TieuDe</h3>
                            <div class="news-list-meta">
                                <i class="far fa-clock mr-1"></i> @item.NgayDang.Value.ToString("dd/MM/yyyy")
                                <span class="mx-2">|</span>
                                <i class="fas fa-eye mr-1"></i> @item.LuotXem lượt xem
                            </div>
                            <div class="news-list-summary">@item.TomTat</div>
                        </div>
                    </a>
                }

                <div class="d-flex justify-content-center mt-4">
                    @Html.PagedListPager(Model, page => Url.Action("Index", new { page }),
                        new PagedListRenderOptions
                             {
                            LiElementClasses = new[] { "page-item" },
                            FunctionToTransformEachPageLink = (liTag, aTag) =>
                                 {
                                aTag.Attributes.Add("class", "page-link text-dark font-weight-bold");
                                liTag.InnerHtml = aTag.ToString();
                                return liTag;
                            }
                        })
                </div>
            }
            else
            {
                <div class="alert alert-light border text-center p-5">
                    <i class="far fa-newspaper fa-3x text-muted mb-3"></i>
                    <h5>Chưa có tin tức nào được đăng tải.</h5>
                </div>
            }
        </div>

        <div class="col-lg-3 col-md-12 mt-4 mt-lg-0">
            <a href="#" class="d-block mb-4">
                <img src="~/Content/client/img/banner-quang-cao-doc.jpg" class="w-100 rounded shadow-sm" alt="Quảng cáo" onerror="this.style.display='none'">
            </a>
        </div>
    </div>
</div>