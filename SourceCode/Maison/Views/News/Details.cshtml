@model Maison.Models.TinTuc
@{
    ViewBag.Title = Model.TieuDe;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* CSS cho trang đọc báo */
    .news-detail-container {
        background-color: #fff;
        padding: 30px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    }

    .news-header-title {
        font-size: 28px;
        font-weight: bold;
        color: #333;
        line-height: 1.4;
        margin-bottom: 15px;
    }

    .news-meta {
        font-size: 13px;
        color: #777;
        margin-bottom: 20px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eee;
    }

    .news-summary-box {
        background-color: #f8f9fa;
        border-left: 4px solid #d70018;
        padding: 15px 20px;
        font-weight: 600;
        font-style: italic;
        color: #444;
        margin-bottom: 30px;
        border-radius: 0 8px 8px 0;
    }
    /* Định dạng lại hình ảnh và video do CKEditor sinh ra để hiển thị chuẩn trên điện thoại */
    .news-body-content img, .news-body-content iframe {
        max-width: 100% !important;
        height: auto !important;
        border-radius: 8px;
        margin: 15px 0;
    }

    .news-body-content p {
        font-size: 16px;
        line-height: 1.7;
        color: #222;
        margin-bottom: 15px;
    }

    /* CSS Cột tin liên quan */
    .related-news-title {
        font-size: 18px;
        font-weight: bold;
        border-bottom: 2px solid #d70018;
        padding-bottom: 10px;
        margin-bottom: 20px;
        text-transform: uppercase;
    }

    .related-item {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 15px;
        text-decoration: none !important;
    }

        .related-item img {
            width: 100px;
            height: 65px;
            object-fit: cover;
            border-radius: 6px;
        }

        .related-item h6 {
            font-size: 14px;
            font-weight: 600;
            color: #333;
            line-height: 1.4;
            margin: 0;
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            transition: color 0.2s;
        }

        .related-item:hover h6 {
            color: #d70018;
        }
</style>

<div class="breadcrumb-area mt-30 mb-30">
    <div class="container">
        <div class="breadcrumb">
            <ul class="d-flex align-items-center">
                <li>@Html.ActionLink("Trang chủ", "Index", "Home")</li>
                <li><a href="@Url.Action("Index", "News")">Tin Công Nghệ</a></li>
                <li class="active">@Model.TieuDe</li>
            </ul>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row">
        <div class="col-lg-8 col-md-12 mb-4">
            <div class="news-detail-container">
                <h1 class="news-header-title">@Model.TieuDe</h1>

                <div class="news-meta d-flex justify-content-between align-items-center">
                    <span><i class="far fa-clock mr-1"></i> @Model.NgayDang.Value.ToString("dd/MM/yyyy - HH:mm")</span>
                    <span><i class="fas fa-eye mr-1"></i> @Model.LuotXem lượt xem</span>
                </div>

                <div class="news-summary-box">
                    @Model.TomTat
                </div>

                <div class="news-body-content">
                    @Html.Raw(Model.NoiDung)
                </div>

                <div class="mt-5 text-right">
                    <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="window.history.back()"><i class="fas fa-arrow-left mr-2"></i> Quay lại</button>
                </div>
            </div>
        </div>

        <div class="col-lg-4 col-md-12">
            <div class="bg-white p-4 rounded shadow-sm sticky-top" style="top: 20px; z-index: 10;">
                <h4 class="related-news-title">Tin công nghệ mới nhất</h4>

                @if (ViewBag.TinLienQuan != null)
                {
                    foreach (var item in ViewBag.TinLienQuan as List<Maison.Models.TinTuc>)
                    {
                        <a href="@Url.Action("Details", "News", new { id = item.MaTin })" class="related-item pb-3 border-bottom">
                            <img src="@item.AnhDaiDien" onerror="this.src='/Content/Images/no-image.png'" alt="@item.TieuDe">
                            <h6>@item.TieuDe</h6>
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>