@model List<Maison.Models.Baohanh>
@{
    ViewBag.Title = "Thông tin Bảo hành";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-area mt-30">
    <div class="container">
        <div class="breadcrumb">
            <ul class="d-flex align-items-center">
                <li>@Html.ActionLink("Trang chủ", "Index", "Home")</li>
                <li class="active">Thông tin Bảo hành</li>
            </ul>
        </div>
    </div>
</div>

<div class="cart-main-area ptb-100 ptb-sm-60">
    <div class="container">
        <div class="row">
            <div class="col-md-12 col-sm-12">
                <div class="table-content table-responsive mb-45">
                    @if (Model == null || Model.Count == 0)
                    {
                        <h4 class="text-center text-muted py-5">Bạn chưa có yêu cầu bảo hành nào.</h4>
                    }
                    else
                    {
                        <table class="table table-bordered table-hover text-center align-middle" style="background-color: white; box-shadow: 0 0 10px rgba(0,0,0,0.05);">
                            <thead class="bg-light">
                                <tr>
                                    <th>Mã Phiếu</th>
                                    <th>Sản phẩm & Cấu hình</th>
                                    <th>Ngày tiếp nhận</th>
                                    <th>Trạng thái</th>
                                    <th>Chi tiết</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    // Tự động ghép nối cấu hình biến thể
                                    string cauHinh = item.BienThe.ChiTietBTs.Any() ? string.Join(" | ", item.BienThe.ChiTietBTs.OrderBy(cb => cb.GiaTriTT.ThuocTinh.ThuTuHienThi).Select(cb => cb.GiaTriTT.GiaTri)) : "Bản tiêu chuẩn";

                                    <tr>
                                        <td class="font-weight-bold">#@item.MaPhieu</td>

                                        <td class="text-left">
                                            <span class="d-block font-weight-bold" style="font-size: 15px;">@item.BienThe.Sanpham.TenSP</span>
                                            <small class="text-muted"><i class="fas fa-microchip"></i> @cauHinh</small>
                                        </td>

                                        <td><b>@(item.NgayTiepNhan?.ToString("dd/MM/yyyy") ?? "Chưa rõ")</b></td>

                                        <td class="font-weight-bold">
                                            @if (item.TrangThai == 0)
                                            {
                                                <span class="text-danger">Đã hủy</span>
                                            }
                                            else if (item.TrangThai == 1)
                                            {
                                                <span class="text-warning">Chờ tiếp nhận</span>
                                            }
                                            else if (item.TrangThai == 2)
                                            {
                                                <span class="text-primary">Đang xử lý</span>
                                            }
                                            else if (item.TrangThai == 3)
                                            {
                                                <span class="text-info">Đã sửa xong</span>
                                            }
                                            else if (item.TrangThai == 4)
                                            {
                                                <span class="text-success">Hoàn thành</span>
                                            }
                                        </td>

                                        <td>
                                            <a href="@Url.Action("Details", "BaoHanh", new { id = item.MaPhieu })" class="btn btn-sm btn-info text-white font-weight-bold">
                                                <i class="fas fa-eye"></i> Xem
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
</div>