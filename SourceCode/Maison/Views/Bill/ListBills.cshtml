@model List<Maison.Models.HoaDon>
@{
    ViewBag.Title = "Đơn hàng của bạn";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="breadcrumb-area mt-30">
    <div class="container">
        <div class="breadcrumb">
            <ul class="d-flex align-items-center">
                <li>@Html.ActionLink("Trang chủ", "Index", "Home")</li>
                <li class="active">Đơn hàng của bạn</li>
            </ul>
        </div>
    </div>
</div>

<div class="cart-main-area ptb-100 ptb-sm-60">
    <div class="container">
        <div class="row">
            <div class="col-md-12 col-sm-12">
                <div class="table-content table-responsive mb-45">
                    @if (Model == null || Model.Count == 0)
                    {
                        <h4 class="text-center text-muted py-5">Bạn chưa có đơn hàng nào.</h4>
                    }
                    else
                    {
                <table class="table table-bordered table-hover text-center align-middle" style="background-color: white; box-shadow: 0 0 10px rgba(0,0,0,0.05);">
                    <thead class="bg-light">
                        <tr>
                            <th class="product-thumbnail">Mã Đơn</th>
                            <th class="product-thumbnail">Ngày đặt</th>
                            <th class="product-name">Người nhận</th>
                            <th class="product-status">Trạng thái Giao</th>
                            <th class="product-status">Thanh toán</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="font-weight-bold">#@item.MaHD</td>
                                <td class="product-thumbnail">
                                    <b>@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</b>
                                </td>
                                <td class="product-name">
                                    @item.HoTenNguoiNhan<br />
                                    <small class="text-muted">@item.SoDienThoaiNhan</small>
                                </td>

                                <td class="product-status font-weight-bold">
                                    @if (item.TrangThai == 0)
                                    {<span class="text-danger">Đã hủy</span> }
                                    else if (item.TrangThai == 1)
                                    { <span class="text-warning">Chờ xác nhận</span> }
                                    else if (item.TrangThai == 2)
                                    { <span class="text-info">Đang giao hàng</span> }
                                    else
                                    { <span class="text-success">Hoàn thành</span>}
                                </td>

                                <td class="product-status">
                                    <span class="badge badge-dark mb-1">@(item.PhuongThucThanhToan == "QR" ? "Chuyển khoản QR" : "Tiền mặt (COD)")</span><br />
                                    @if (item.TrangThaiThanhToan == 1)
                                    {
                                        <span class="text-success font-weight-bold"><i class="fas fa-check-circle"></i> Đã thanh toán</span>
                                    }
                                    else
                                    {
                                        <span class="text-danger font-weight-bold"><i class="fas fa-times-circle"></i> Chưa thanh toán</span>
                                    }
                                </td>

                                <td>
                                    <a href="@Url.Action("Details","Bill", new { id = item.MaHD })" class="btn btn-sm btn-outline-primary mb-1">Chi tiết</a>

                                    @if (item.TrangThai == 1)
                                    {
                                        <button class="btn btn-sm btn-outline-danger mb-1" type="button" onclick="huyDonHang(@item.MaHD)">Hủy đơn</button>

                                        // NẾU LÀ ĐƠN QR VÀ CHƯA THANH TOÁN -> HIỆN NÚT QUÉT MÃ LẠI
                                        if (item.PhuongThucThanhToan == "QR" && item.TrangThaiThanhToan == 0)
                                        {
                                            <a href="@Url.Action("PaymentQR", "Bill", new { id = item.MaHD })" class="btn btn-sm btn-success font-weight-bold text-white mb-1">
                                                <i class="fas fa-qrcode"></i> Thanh toán
                                            </a>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                    }
                </div>



            </div>
        </div>
    </div>
</div>

@section Script{
    <script>
        function huyDonHang(mahd) {
            swal({
                title: "Bạn chắc chắn muốn hủy?",
                text: "Đơn hàng sau khi hủy sẽ không thể khôi phục!",
                icon: "warning",
                buttons: ["Quay lại", "Đồng ý Hủy"],
                dangerMode: true,
            })
            .then((willDelete) => {
                if (willDelete) {
                    $.ajax({
                        url: '/Bill/ChangeStatus',
                        type: 'POST',
                        data: { mahd: mahd, stt: 0 },
                        success: function (res) {
                            if (res.status) {
                                swal("Thành công!", "Đã hủy đơn hàng thành công.", "success").then(() => location.reload());
                            } else {
                                swal("Lỗi!", res.message ? res.message : "Không thể hủy đơn hàng này.", "error");
                            }
                        }
                    });
                }
            });
        }
    </script>
}