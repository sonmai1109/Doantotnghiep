@model IEnumerable<Maison.Models.Sanpham>

<style>
    /* Hiệu ứng hover đổi màu nền xám nhẹ khi di chuột vào sản phẩm */
    .search-item-row:hover {
        background-color: #f8f9fa;
    }
</style>

@if (Model.Any())
{
    <ul class="list-unstyled mb-0">
        @foreach (var item in Model)
        {
            <li class="p-2 border-bottom search-item-row" style="transition: 0.2s;">
                <a href="@Url.Action("ProductDetail", "Product", new { id = item.MaSP })" class="d-flex align-items-center text-decoration-none text-dark" style="gap: 15px;">

                    <img src="@item.HinhAnh" alt="@item.TenSP" style="width: 50px; height: 50px; object-fit: contain; border-radius: 4px; border: 1px solid #eaeaea;">

                    <div style="flex: 1; overflow: hidden;">
                        <h6 class="mb-0 text-truncate" style="font-size: 14px; font-weight: 600;">@item.TenSP</h6>
                        <small class="text-muted">Danh mục: @(item.DanhMuc != null ? item.DanhMuc.TenDM : "Đang cập nhật")</small>
                    </div>
                </a>
            </li>
        }
    </ul>

    <div class="text-center p-2 bg-light">
        <a href="#" class="text-danger text-decoration-none" style="font-size: 13px; font-weight: bold;">Xem tất cả kết quả</a>
    </div>
}
