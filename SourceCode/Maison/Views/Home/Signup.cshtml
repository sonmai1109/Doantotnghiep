@model Maison.Models.TaiKhoanNguoiDung

@{
    ViewBag.Title = "Đăng ký";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/axios/0.21.1/axios.min.js"></script>
<div class="breadcrumb-area mt-30">
    <div class="container">
        <div class="breadcrumb">
            <ul class="d-flex align-items-center">
                <li>@Html.ActionLink("Trang chủ", "Index", "Home")</li>
                <li class="active">@Html.ActionLink("Đăng Ký", "SignUp")</li>
                <!-- <li class="active"><a href="contact.html">contact us</a></li> -->
            </ul>
        </div>
    </div>
    <!-- Container End -->
</div>
<div class="container mt-3 pr-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg">
                <div class="card-header text-center bg-primary text-white">
                    <h4>Đăng ký tài khoản</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("SignUp", "Home", FormMethod.Post))
                    {
                        <div class="mb-3">
                            <label>Tên đăng nhập</label>
                            @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control", placeholder = "Nhập tên đăng nhập" })
                            @if (ViewBag.mess != null)
                            {
                                <div class="alert alert-danger mt-1">
                                    @ViewBag.mess
                                </div>
                            }
                            @Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label>Mật khẩu</label>
                            <!-- Thêm autocomplete = "new-password" -->
                            @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control", placeholder = "Nhập mật khẩu (Ít nhất 6 ký tự...)", autocomplete = "new-password" })
                            @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label>Nhập lại mật khẩu</label>
                            <!-- Thêm autocomplete = "new-password" -->
                            <input type="password" name="XacNhanMatKhau" class="form-control" placeholder="Xác nhận mật khẩu" autocomplete="new-password" required />
                            @if (ViewBag.LoiXacNhan != null)
                            {
                                <span class="text-danger">@ViewBag.LoiXacNhan</span>
                            }
                        </div>

                        <div class="mb-3">
                            <label>Họ tên</label>
                            @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control", placeholder = "Nhập họ tên" })
                            @Html.ValidationMessageFor(m => m.HoTen, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label>Số điện thoại</label>
                            @Html.TextBoxFor(m => m.SoDienThoai, new { @class = "form-control", placeholder = "Nhập số điện thoại" })
                            @Html.ValidationMessageFor(m => m.SoDienThoai, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label>Email</label>
                            <!-- Thêm autocomplete = "off" -->
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Nhập email", autocomplete = "off" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>

                        <!-- PHẦN ĐỊA CHỈ -->
                        <div class="mb-3">
                            <label>Địa chỉ</label>
                            <input type="text" id="diaChiNha" class="form-control mb-2" placeholder="Số nhà, tên đường..." autocomplete="off">

                            <div class="row">
                                <div class="col-md-4">
                                    <select class="form-control mb-3" id="city" required>
                                        <option value="" selected>Chọn tỉnh thành</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <select class="form-control mb-3" id="district" required>
                                        <option value="" selected>Chọn quận huyện</option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <select class="form-control mb-3" id="ward" required>
                                        <option value="" selected>Chọn phường xã</option>
                                    </select>
                                </div>
                            </div>

                            <!-- CÁC Ô ẨN DÙNG ĐỂ LƯU CHUYỂN DỮ LIỆU GIỮA VIEW VÀ CONTROLLER -->
                            @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control", id = "DiaChi_Hidden", style = "display:none;" })
                            <input type="hidden" id="hdnCity" name="CityId" value="@ViewBag.CityId" />
                            <input type="hidden" id="hdnDistrict" name="DistrictId" value="@ViewBag.DistrictId" />
                            <input type="hidden" id="hdnWard" name="WardId" value="@ViewBag.WardId" />
                            <input type="hidden" id="hdnNha" name="SoNha" value="@ViewBag.SoNha" />
                        </div>

                        <div class="mb-3">
                            <label>Ngày sinh</label>
                            @Html.TextBoxFor(m => m.NgaySinh, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.NgaySinh, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            <label>Giới tính</label>
                            @Html.DropDownListFor(m => m.GioiTinh,
                                new List<SelectListItem>
                              {
                                 new SelectListItem { Text = "-- Chọn giới tính --", Value = "" },
                                 new SelectListItem { Text = "Nam", Value = "1" },
                                 new SelectListItem { Text = "Nữ", Value = "2" }
                               },
                                 new { @class = "form-control" })

                            @Html.ValidationMessageFor(m => m.GioiTinh, "", new { @class = "text-danger" })
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-success w-100">
                                Đăng ký
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <a href="@Url.Action("Login","Home")">
                                Đã có tài khoản? Đăng nhập
                            </a>
                        </div>

                        <div class="text-danger text-center mt-2">
                            @*@Html.ValidationSummary()*@
                        </div>

                    }

                </div>
            </div>

        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        var citis = document.getElementById("city");
        var districts = document.getElementById("district");
        var wards = document.getElementById("ward");
        var diaChiGoc = document.getElementById("DiaChi_Hidden");
        var diaChiNha = document.getElementById("diaChiNha");

        var hdnCity = document.getElementById("hdnCity");
        var hdnDistrict = document.getElementById("hdnDistrict");
        var hdnWard = document.getElementById("hdnWard");
        var hdnNha = document.getElementById("hdnNha");

        // FIX LỖI: Lấy giá trị khởi tạo lưu vào biến trước khi Javascript làm thay đổi DOM
        var initCity = hdnCity.value;
        var initDistrict = hdnDistrict.value;
        var initWard = hdnWard.value;
        var initNha = hdnNha.value;

        var promise = axios({
            url: "https://raw.githubusercontent.com/kenzouno1/DiaGioiHanhChinhVN/master/data.json",
            method: "GET",
            responseType: "application/json",
        });

        promise.then(function (result) {
            renderCity(result.data);

            // TỰ ĐỘNG PHỤC HỒI DỮ LIỆU DỰA TRÊN BIẾN INIT (Chống bị đè)
            if (initNha) { diaChiNha.value = initNha; }
            if (initCity) {
                citis.value = initCity;
                citis.dispatchEvent(new Event('change')); // Tự động click gọi Quận/Huyện

                if (initDistrict) {
                    districts.value = initDistrict;
                    districts.dispatchEvent(new Event('change')); // Tự động click gọi Phường/Xã

                    if (initWard) {
                        wards.value = initWard;
                        updateDiaChi(); // Chốt lại chuỗi cuối cùng
                    }
                }
            }
        });

        function renderCity(data) {
            for (const x of data) {
                citis.options[citis.options.length] = new Option(x.Name, x.Id);
            }
            citis.onchange = function () {
                districts.length = 1;
                wards.length = 1;
                if (this.value != "") {
                    const result = data.filter(n => n.Id === this.value);
                    for (const k of result[0].Districts) {
                        districts.options[districts.options.length] = new Option(k.Name, k.Id);
                    }
                }
                updateDiaChi();
            };
            districts.onchange = function () {
                wards.length = 1;
                const dataCity = data.filter((n) => n.Id === citis.value);
                if (this.value != "") {
                    const dataWards = dataCity[0].Districts.filter(n => n.Id === this.value)[0].Wards;
                    for (const w of dataWards) {
                        wards.options[wards.options.length] = new Option(w.Name, w.Id);
                    }
                }
                updateDiaChi();
            };
            wards.onchange = function () { updateDiaChi(); };
            diaChiNha.oninput = function () { updateDiaChi(); }
        }

        function updateDiaChi() {
            var nha = diaChiNha.value.trim();
            // Lấy text của option đang chọn
            var tenXa = wards.selectedIndex > 0 ? wards.options[wards.selectedIndex].text : "";
            var tenHuyen = districts.selectedIndex > 0 ? districts.options[districts.selectedIndex].text : "";
            var tenTinh = citis.selectedIndex > 0 ? citis.options[citis.selectedIndex].text : "";

            var fullAddress = [];
            if (nha !== "") fullAddress.push(nha);
            if (tenXa !== "") fullAddress.push(tenXa);
            if (tenHuyen !== "") fullAddress.push(tenHuyen);
            if (tenTinh !== "") fullAddress.push(tenTinh);

            // Ném chuỗi đầy đủ vào ô DiaChi_Hidden để gửi xuống Database
            diaChiGoc.value = fullAddress.join(", ");

            // Lưu lại ID vào ô ẩn để gửi lên Controller cho lần sau (nếu bị lỗi form)
            hdnCity.value = citis.value;
            hdnDistrict.value = districts.value;
            hdnWard.value = wards.value;
            hdnNha.value = nha;
        }
    });
</script>