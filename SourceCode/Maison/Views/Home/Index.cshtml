@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var info = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}
<style>
    /* CSS Card Sản phẩm mang phong cách CellphoneS */
    .block-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

        .block-title h2 {
            font-size: 22px;
            font-weight: 700;
            text-transform: uppercase;
            color: #333;
            margin: 0;
        }

    .cps-card {
        background: #fff;
        border-radius: 10px;
        padding: 15px;
        border: 1px solid #f0f0f0;
        transition: all 0.3s ease;
        position: relative;
        box-shadow: 0 1px 4px rgba(0,0,0,0.05);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .cps-card:hover {
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            transform: translateY(-5px);
            border-color: #d70018;
        }

    .discount-badge {
        position: absolute;
        top: 10px;
        left: -5px;
        background: #d70018;
        color: #fff;
        font-weight: bold;
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 0 15px 15px 0;
        z-index: 2;
        box-shadow: 2px 2px 5px rgba(0,0,0,0.2);
    }

    .cps-card-img {
        text-align: center;
        margin-bottom: 15px;
    }

        .cps-card-img img {
            max-width: 100%;
            height: 180px;
            object-fit: contain;
            transition: transform 0.3s;
        }

    .cps-card:hover .cps-card-img img {
        transform: scale(1.05);
    }

    .cps-card-title {
        font-size: 14px;
        font-weight: 600;
        color: #333;
        text-decoration: none;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 10px;
        line-height: 1.4;
    }

        .cps-card-title:hover {
            color: #d70018;
        }

    .cps-price-box {
        margin-top: auto;
    }

    .cps-price-new {
        color: #d70018;
        font-size: 16px;
        font-weight: 700;
        display: block;
    }

    .cps-price-old {
        color: #707070;
        font-size: 13px;
        text-decoration: line-through;
    }

    .promo-banner {
        display: block;
        overflow: hidden;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        height: 100%;
        background-color: #000;
    }

    .carousel-inner, .carousel-item {
        background-color: #000;
    }

    .promo-banner img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .variant-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 10px;
    }

    .v-tag {
        border: 1px solid #e0e0e0;
        border-radius: 4px;
        padding: 3px 8px;
        font-size: 11px;
        color: #555;
        background-color: #fcfcfc;
        white-space: nowrap;
    }

    .grid-5-cols {
        display: flex;
        flex-wrap: wrap;
        margin-left: -10px;
        margin-right: -10px;
    }

        .grid-5-cols > .col-item {
            flex: 0 0 20%;
            max-width: 20%;
            padding-left: 10px;
            padding-right: 10px;
            margin-bottom: 20px;
        }

    /* CSS hỗ trợ Tabs Khuyến mãi mượt mà */
    #promoTabs .nav-link {
        transition: all 0.3s ease;
        border-radius: 20px !important;
    }

        #promoTabs .nav-link.active {
            background-color: #fff !important;
            color: #d70018 !important;
            border: 1px solid #d70018 !important;
            box-shadow: 0 4px 6px rgba(215, 0, 24, 0.15);
        }

        #promoTabs .nav-link:hover:not(.active) {
            background-color: #ffe6e6 !important;
            color: #d70018 !important;
        }

    /* CSS Đồng hồ đếm ngược */
    .flash-sale-timer {
        display: flex;
        align-items: center;
        gap: 5px;
        background: #d70018;
        padding: 5px 15px;
        border-radius: 30px;
        color: white;
        font-weight: bold;
    }

    .timer-box {
        background: white;
        color: #d70018;
        padding: 2px 6px;
        border-radius: 4px;
        font-size: 14px;
    }
    /* CSS cho Thanh Tiến Trình Flash Sale */
    .flash-sale-progress {
        background-color: #ffcccc;
        border-radius: 10px;
        position: relative;
        height: 18px;
        width: 100%;
        margin-top: 10px;
        overflow: hidden;
    }

        .flash-sale-progress .progress-bar-fill {
            background: linear-gradient(90deg, #ff416c 0%, #ff4b2b 100%);
            height: 100%;
            border-radius: 10px;
            transition: width 0.5s ease;
        }

        .flash-sale-progress .progress-text {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            text-align: center;
            font-size: 11px;
            color: white;
            font-weight: bold;
            line-height: 18px;
            text-shadow: 1px 1px 2px rgba(0,0,0,0.5);
        }   
</style>

<div class="container">
    <div class="row mb-3 mt-1">
        <div class="col-12">
            <div id="mainBannerCarousel" class="carousel slide carousel-fade promo-banner" data-bs-ride="carousel" data-bs-interval="3000">

                <div class="carousel-inner h-100">

                    <div class="carousel-item active h-100">
                        <a href="#">
                            <img src="~/Content/client/img/10.png" class="d-block w-100 h-100" style="object-fit: cover;" alt="Sale gấp PC 1">
                        </a>
                    </div>

                    <div class="carousel-item h-100">
                        <a href="#">
                            <img src="~/Content/client/img/11.png" class="d-block w-100 h-100" style="object-fit: cover;" alt="Sale gấp PC 2">
                        </a>
                    </div>

                    <div class="carousel-item h-100">
                        <a href="#">
                            <img src="~/Content/client/img/12.png" class="d-block w-100 h-100" style="object-fit: cover;" alt="Sale gấp PC 3">
                        </a>
                    </div>
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#mainBannerCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Trước</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#mainBannerCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Sau</span>
                </button>
            </div>
        </div>
    </div>

    <div class="row mb-4 g-3">
        <div class="col-md-4 col-sm-12">
            <a href="#" class="promo-banner">
                <img src="~/Content/client/img/5.png" alt="Banner Nhỏ 1">
            </a>
        </div>
        <div class="col-md-4 col-sm-12">
            <a href="#" class="promo-banner">
                <img src="~/Content/client/img/6.png" alt="Banner Nhỏ 2">
            </a>
        </div>
        <div class="col-md-4 col-sm-12">
            <a href="#" class="promo-banner">
                <img src="~/Content/client/img/7.png" alt="Banner Nhỏ 3">
            </a>
        </div>
    </div>

    <div class="block-title mt-5">
        <h2>🔥 Vườn Bách Deal - Bách Trúng</h2>
    </div>

    @{
        var activePromos = ViewBag.ActivePromos as List<Maison.Models.KhuyenMai>;
        var hotSaleItems = ViewBag.HotSaleItems as List<Maison.Controllers.HotSaleDTO>;
    }

    @if (activePromos != null && activePromos.Any() && hotSaleItems != null && hotSaleItems.Any())
    {
        <ul class="nav nav-tabs border-0 mb-4" id="promoTabs" role="tablist" style="gap: 10px; flex-wrap: nowrap; overflow-x: auto; padding-bottom: 5px;">
            <li class="nav-item" role="presentation">
                <button class="nav-link active font-weight-bold rounded px-4 py-2 border" style="white-space: nowrap; color: #d70018;" id="all-deal-tab" data-bs-toggle="tab" data-bs-target="#alldeal" type="button" role="tab">
                    🔥 Tất cả Deal
                </button>
            </li>

            @foreach (var km in activePromos)
            {
                <li class="nav-item" role="presentation">
                    <button class="nav-link font-weight-bold rounded px-4 py-2 border text-dark bg-light" style="white-space: nowrap;" id="tab-@km.MaKM" data-bs-toggle="tab" data-bs-target="#content-@km.MaKM" type="button" role="tab">
                        @km.TenKM
                    </button>
                </li>
            }
        </ul>

        <div class="tab-content" id="promoTabsContent">

            <div class="tab-pane fade show active" id="alldeal" role="tabpanel">
                <div class="grid-5-cols">
                    @foreach (var item in hotSaleItems)
                    {
                        var sp = item.BienThe.Sanpham;
                        var anhHienThi = !string.IsNullOrEmpty(item.BienThe.HinhAnh) ? item.BienThe.HinhAnh : sp.HinhAnh;

                        // Lấy các tag cấu hình chính
                        var cacTagThongSo = item.BienThe.ChiTietBTs
                            .Where(c => c.GiaTriTT.ThuocTinh.LaThuocTinhChinh == true)
                            .OrderBy(c => c.GiaTriTT.ThuocTinh.ThuTuHienThi)
                            .Select(c => c.GiaTriTT.GiaTri).ToList();

                        <div class="col-item">
                            <div class="cps-card" style="height: 100%;">
                                <div class="discount-badge">Giảm @item.PhanTramMax%</div>

                                <a href="@Url.Action("ProductDetail", "Product", new { id = sp.MaSP })" class="cps-card-img">
                                    <img src="@anhHienThi" onerror="this.src='/Content/Images/no-image.png'" alt="@sp.TenSP" />
                                </a>

                                <a href="@Url.Action("ProductDetail", "Product", new { id = sp.MaSP })" class="cps-card-title">@sp.TenSP</a>

                                <div class="cps-price-box">
                                    <span class="cps-price-new">@string.Format(info, "{0:c0}", item.GiaSauGiam)</span>
                                    <span class="cps-price-old">@string.Format(info, "{0:c0}", item.BienThe.GiaBan)</span>
                                </div>


                                @if (cacTagThongSo.Any())
                                {
                                    <div class="variant-tags mt-2">
                                        @foreach (var tag in cacTagThongSo)
                                        {
                                            <span class="v-tag" style="background-color: #fff3f3; color: #d70018; border-color: #ffcccc;">@tag</span>
                                        }
                                    </div>
                                }
                                @if (item.SoLuongKhuyenMai.HasValue)
                                {
                                    int soLuongTong = item.SoLuongKhuyenMai.Value;
                                    int daBan = item.SoLuongDaBan;
                                    double pt = soLuongTong > 0 ? (double)daBan / soLuongTong * 100 : 0;
                                    if (pt > 100) { pt = 100; }

                                    <div class="flash-sale-progress mt-3">
                                        <div class="progress-bar-fill" style="width: @pt"></div>
                                        <div class="progress-text">
                                            @if (daBan >= soLuongTong)
                                            {
                                                <span style="color: #fff1f1;">Hết suất</span>
                                            }
                                            else if (daBan == 0)
                                            {
                                                <span>Vừa mở bán</span>
                                            }
                                            else
                                            {
                                                <span>Đã bán @daBan/@soLuongTong suất</span>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div style="height: 28px; margin-top: 10px;"></div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            @foreach (var km in activePromos)
            {
                <div class="tab-pane fade" id="content-@km.MaKM" role="tabpanel">
                    <div class="grid-5-cols">
                        @foreach (var item in hotSaleItems.Where(x => x.ThuocCacChuyenTrinh.Contains(km.MaKM)))
                        {
                            var sp = item.BienThe.Sanpham;
                            var anhHienThi = !string.IsNullOrEmpty(item.BienThe.HinhAnh) ? item.BienThe.HinhAnh : sp.HinhAnh;

                            var cacTagThongSo = item.BienThe.ChiTietBTs
                                .Where(c => c.GiaTriTT.ThuocTinh.LaThuocTinhChinh == true)
                                .OrderBy(c => c.GiaTriTT.ThuocTinh.ThuTuHienThi)
                                .Select(c => c.GiaTriTT.GiaTri).ToList();

                            <div class="col-item">
                                <div class="cps-card" style="height: 100%;">
                                    <div class="discount-badge">Giảm @item.PhanTramMax%</div>

                                    <a href="@Url.Action("ProductDetail", "Product", new { id = sp.MaSP })" class="cps-card-img">
                                        <img src="@anhHienThi" onerror="this.src='/Content/Images/no-image.png'" alt="@sp.TenSP" />
                                    </a>

                                    <a href="@Url.Action("ProductDetail", "Product", new { id = sp.MaSP })" class="cps-card-title">@sp.TenSP</a>

                                    <div class="cps-price-box">
                                        <span class="cps-price-new">@string.Format(info, "{0:c0}", item.GiaSauGiam)</span>
                                        <span class="cps-price-old">@string.Format(info, "{0:c0}", item.BienThe.GiaBan)</span>
                                    </div>

                                    @if (cacTagThongSo.Any())
                                    {
                                        <div class="variant-tags mt-2">
                                            @foreach (var tag in cacTagThongSo)
                                            {
                                                <span class="v-tag" style="background-color: #fff3f3; color: #d70018; border-color: #ffcccc;">@tag</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted font-italic">Hiện tại không có chương trình khuyến mãi nào.</p>
    }
    <div class="block-title mt-5">
        <h2>✨ Sản Phẩm Mới Ra Mắt</h2>
    </div>
    <div class="grid-5-cols">
        @if (ViewBag.SanPhamMoi != null)
        {
            foreach (var sp in ViewBag.SanPhamMoi as List<Maison.Models.Sanpham>)
            {
                <div class="col-item">
                    <div class="cps-card" style="height: 100%;">
                        @{
                            // 1. TÌM CẤU HÌNH CÓ % GIẢM LỚN NHẤT (NẾU BẰNG NHAU HOẶC = 0 THÌ LẤY RẺ NHẤT)
                            decimal minGiaSauGiam = decimal.MaxValue;
                            decimal giaGocCuaBanReNhat = 0;
                            int phanTramHienThi = -1;

                            if (sp.BienThes != null && sp.BienThes.Any())
                            {
                                foreach (var bt in sp.BienThes)
                                {
                                    var activeKMs = sp.SanPhamKhuyenMais != null
                                        ? sp.SanPhamKhuyenMais.Where(k => k.KhuyenMai != null && k.KhuyenMai.TrangThai == 1 && k.KhuyenMai.NgayBatDau <= DateTime.Now && k.KhuyenMai.NgayKetThuc >= DateTime.Now)
                                        : Enumerable.Empty<Maison.Models.SanPhamKhuyenMai>();

                                    int maxRieng = activeKMs.Where(k => k.MaBT == bt.MaBT).Select(k => k.PhanTramGiam).DefaultIfEmpty(0).Max();
                                    int maxChung = activeKMs.Where(k => k.MaBT == null).Select(k => k.PhanTramGiam).DefaultIfEmpty(0).Max();
                                    int phanTram = Math.Max(maxRieng, maxChung);

                                    decimal giaSauGiam = bt.GiaBan * (1 - (decimal)phanTram / 100);

                                    // So sánh ưu tiên 1: % giảm cao nhất. Ưu tiên 2: Giá rẻ nhất
                                    if (phanTram > phanTramHienThi || (phanTram == phanTramHienThi && giaSauGiam < minGiaSauGiam))
                                    {
                                        minGiaSauGiam = giaSauGiam;
                                        giaGocCuaBanReNhat = bt.GiaBan;
                                        phanTramHienThi = phanTram;
                                    }
                                }
                            }

                            // 2. LỌC VÀ LẤY TAG THÔNG SỐ ĐỂ HIỂN THỊ (Gom nhóm, Xóa trùng, Xếp thứ tự 0, 1, 2...)
                            var cacTagThongSo = sp.BienThes != null ? sp.BienThes
                                .SelectMany(b => b.ChiTietBTs)
                                .Where(c => c.GiaTriTT != null && c.GiaTriTT.ThuocTinh != null && c.GiaTriTT.ThuocTinh.LaThuocTinhChinh == true)
                                .GroupBy(c => c.GiaTriTT.GiaTri)
                                .Select(g => g.First())
                                .OrderBy(c => c.GiaTriTT.ThuocTinh.ThuTuHienThi)
                                .Select(c => c.GiaTriTT.GiaTri)
                                .ToList() : new List<string>();
                        }

                        @if (phanTramHienThi > 0)
                        {
                            <div class="discount-badge">Giảm @phanTramHienThi%</div>
                        }

                        <a href="@Url.Action("ProductDetail", "Product", new { id = sp.MaSP })" class="cps-card-img">
                            <img src="@sp.HinhAnh" onerror="this.src='/Content/Images/no-image.png'" alt="@sp.TenSP" />
                        </a>

                        <a href="@Url.Action("ProductDetail", "Product", new { id = sp.MaSP })" class="cps-card-title">
                            @sp.TenSP
                        </a>

                        <div class="cps-price-box">
                            @if (minGiaSauGiam != decimal.MaxValue)
                            {
                                <span class="cps-price-new">@string.Format(info, "{0:c0}", minGiaSauGiam)</span>
                                if (phanTramHienThi > 0)
                                {
                                    <span class="cps-price-old">@string.Format(info, "{0:c0}", giaGocCuaBanReNhat)</span>
                                }
                            }
                            else
                            {
                                <span class="cps-price-new text-muted" style="font-size:14px;">Đang cập nhật giá</span>
                            }
                        </div>

                        @if (cacTagThongSo.Any())
                        {
                            <div class="variant-tags mt-2" style="display: flex; flex-wrap: wrap; gap: 5px;">
                                @foreach (var tag in cacTagThongSo)
                                {
                                    <span class="v-tag" style="font-size: 11px; color: #555; background: #f3f4f6; padding: 3px 6px; border: 1px solid #e5e7eb; border-radius: 4px;">
                                        @tag
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <div class="block-title mt-5">
        <h2>💰 Giá Tốt Chốt Ngay</h2>
    </div>
    <div class="grid-5-cols">
        @if (ViewBag.GiaTot != null)
