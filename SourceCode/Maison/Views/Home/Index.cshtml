@{
    ViewBag.Title = "Trang chủ";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var info = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<style>
    /* CSS Card Sản phẩm mang phong cách CellphoneS */
    .block-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
    }

        .block-title h2 {
            font-size: 22px;
            font-weight: 700;
            text-transform: uppercase;
            color: #333;
            margin: 0;
        }

    .cps-card {
        background: #fff;
        border-radius: 10px;
        padding: 15px;
        border: 1px solid #f0f0f0;
        transition: all 0.3s ease;
        position: relative;
        box-shadow: 0 1px 4px rgba(0,0,0,0.05);
        height: 100%;
        display: flex;
        flex-direction: column;
    }

        .cps-card:hover {
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
            transform: translateY(-5px);
            border-color: #d70018;
        }

    .discount-badge {
        position: absolute;
        top: 10px;
        left: -5px;
        background: #d70018;
        color: #fff;
        font-weight: bold;
        font-size: 12px;
        padding: 4px 10px;
        border-radius: 0 15px 15px 0;
        z-index: 2;
        box-shadow: 2px 2px 5px rgba(0,0,0,0.2);
    }

    .cps-card-img {
        text-align: center;
        margin-bottom: 15px;
    }

        .cps-card-img img {
            max-width: 100%;
            height: 180px;
            object-fit: contain;
            transition: transform 0.3s;
        }

    .cps-card:hover .cps-card-img img {
        transform: scale(1.05);
    }

    .cps-card-title {
        font-size: 14px;
        font-weight: 600;
        color: #333;
        text-decoration: none;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 10px;
        line-height: 1.4;
    }

        .cps-card-title:hover {
            color: #d70018;
        }

    .cps-price-box {
        margin-top: auto;
    }

    .cps-price-new {
        color: #d70018;
        font-size: 16px;
        font-weight: 700;
        display: block;
    }

    .cps-price-old {
        color: #707070;
        font-size: 13px;
        text-decoration: line-through;
    }
    /* CSS cho Banner */
    /* CSS cho Banner */
    .promo-banner {
        display: block;
        overflow: hidden;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        height: 100%;
        background-color: #000; /* Đổi thành màu đen hoặc mã màu trùng với viền ảnh banner của bạn */
    }

    .carousel-inner, .carousel-item {
        background-color: #000;
    }
    /* Thêm đoạn này để ép các khung hình dính chặt vào nhau */


    .promo-banner img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    /* CSS cho các ô thuộc tính nhỏ (Variant Tags) */
    .variant-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 10px;
    }

    .v-tag {
        border: 1px solid #e0e0e0;
        border-radius: 4px;
        padding: 3px 8px;
        font-size: 11px;
        color: #555;
        background-color: #fcfcfc;
        white-space: nowrap;
    }
    /* =======================================
       CSS ÉP LƯỚI 5 CỘT (TỰ RỚT DÒNG)
       ======================================= */
    .grid-5-cols {
        display: flex;
        flex-wrap: wrap; /* Lệnh quan trọng: Hết chỗ là bắt buộc rớt dòng */
        margin-left: -10px;
        margin-right: -10px;
    }

    .grid-5-cols > .col-item {
        flex: 0 0 20%; /* Lệnh quan trọng: Chiếm ĐÚNG 20% chiều ngang (100% / 5 = 20%) */
        max-width: 20%;
        padding-left: 10px;
        padding-right: 10px;
        margin-bottom: 20px; /* Khoảng cách giữa hàng trên và hàng dưới */
    }

    /* Reponsive: Nếu xem trên Ipad thì hiện 3 cái 1 hàng */
    /*media (max-width: 991px) {
        .grid-5-cols > .col-item { flex: 0 0 33.3333%; max-width: 33.3333%; }
    }*/
    /* Reponsive: Nếu xem trên Điện thoại thì hiện 2 cái 1 hàng */
    /*media (max-width: 767px) {
        .grid-5-cols > .col-item { flex: 0 0 50%; max-width: 50%; }
    }*/
</style>

<div class="container">
    <div class="row mb-3 mt-1">
        <div class="col-12">
            <div id="mainBannerCarousel" class="carousel slide carousel-fade promo-banner" data-bs-ride="carousel" data-bs-interval="3000">

                <div class="carousel-inner h-100">

                    <div class="carousel-item active h-100">
                        <a href="#">
                            <img src="~/Content/client/img/10.png" class="d-block w-100 h-100" style="object-fit: cover;" alt="Sale gấp PC 1">
                        </a>
                    </div>

                    <div class="carousel-item h-100">
                        <a href="#">
                            <img src="~/Content/client/img/11.png" class="d-block w-100 h-100" style="object-fit: cover;" alt="Sale gấp PC 2">
                        </a>
                    </div>

                    <div class="carousel-item h-100">
                        <a href="#">
                            <img src="~/Content/client/img/12.png" class="d-block w-100 h-100" style="object-fit: cover;" alt="Sale gấp PC 3">
                        </a>
                    </div>
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#mainBannerCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Trước</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#mainBannerCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Sau</span>
                </button>
            </div>
        </div>
    </div>

    <div class="row mb-4 g-3">
        <div class="col-md-4 col-sm-12">
            <a href="#" class="promo-banner">
                <img src="~/Content/client/img/5.png" alt="Banner Nhỏ 1">
            </a>
        </div>
        <div class="col-md-4 col-sm-12">
            <a href="#" class="promo-banner">
                <img src="~/Content/client/img/6.png" alt="Banner Nhỏ 2">
            </a>
        </div>
        <div class="col-md-4 col-sm-12">
            <a href="#" class="promo-banner">
                <img src="~/Content/client/img/7.png" alt="Banner Nhỏ 3">
            </a>
        </div>
    </div>

    <div class="block-title mt-5">
        <h2>🔥 HOT SALE Cuối Tuần</h2>
    </div>

    <div class="grid-5-cols">
        @if (ViewBag.SanPhamKhuyenMai != null)
        {
            // Nhận đúng danh sách Khuyến Mãi từ Controller
            var listKM = ViewBag.SanPhamKhuyenMai as List<Maison.Models.SanPhamKhuyenMai>;

            foreach (var km in listKM)
            {
                var sp = km.Sanpham;
                if (sp == null || sp.BienThes == null) { continue; } // Bỏ qua nếu lỗi data

                Maison.Models.BienThe btHienThi = null;

                // LẤY LUÔN % GIẢM TỪ DATABASE (Đã được Controller lọc to nhất rồi, không cần Math.Max nữa)
                int phanTramChot = Convert.ToInt32(km.PhanTramGiam);

                if (km.MaBT != null)
                {
                    // 1. NHÓM KM RIÊNG: Bốc chính xác cấu hình được giảm giá riêng
                    btHienThi = sp.BienThes.FirstOrDefault(b => b.MaBT == km.MaBT);
                }
                else
                {
                    // 2. NHÓM KM CHUNG: Bốc cấu hình đại diện (Rẻ nhất)
                    // BÍ QUYẾT: Tìm xem những cấu hình nào CỦA SẢN PHẨM NÀY đã có KM riêng rồi, thì "cách ly" nó ra
                    var cacBanDaCoKmRieng = listKM.Where(x => x.MaSP == sp.MaSP && x.MaBT != null)
                                                  .Select(x => x.MaBT)
                                                  .ToList();

                    // Chọn bản có giá gốc rẻ nhất NHƯNG PHẢI NẰM NGOÀI DANH SÁCH BỊ "CÁCH LY"
                    btHienThi = sp.BienThes
                                  .Where(b => !cacBanDaCoKmRieng.Contains(b.MaBT))
                                  .OrderBy(b => b.GiaBan)
                                  .FirstOrDefault();

                    // Nếu tất cả cấu hình đều có KM riêng hết rồi, thì cái KM chung này bị "thừa" -> Bỏ qua không vẽ thẻ nữa!
                    if (btHienThi == null) { continue; }
                }

                if (btHienThi == null) { continue; }

                // 3. TÍNH TIỀN & LẤY ẢNH (Đúng ảnh cấu hình đó)
                decimal giaSauGiam = btHienThi.GiaBan * (1 - (decimal)phanTramChot / 100);
                string anhHienThi = !string.IsNullOrEmpty(btHienThi.HinhAnh) ? btHienThi.HinhAnh : sp.HinhAnh;

                // 4. LẤY THUỘC TÍNH (Đóng gói vào các ô Xám nhỏ)
                var thuocTinhs = btHienThi.ChiTietBTs.Where(c => c.GiaTriTT.ThuocTinh.LaThuocTinhChinh).Select(c => c.GiaTriTT.GiaTri).ToList();

                <div class="col-item">
                    <div class="cps-card">
                        @if (phanTramChot > 0)
                        {
                            <div class="discount-badge">Giảm @phanTramChot%</div>
                        }

                        <a href="@Url.Action("ProductDetail", "Product", new { id = sp.MaSP })" class="cps-card-img">
                            <img src="@anhHienThi" onerror="this.src='/Content/Images/no-image.png'" alt="@sp.TenSP" />
                        </a>

                        <a href="@Url.Action("ProductDetail", "Product", new { id = sp.MaSP })" class="cps-card-title">
                            @sp.TenSP
                        </a>

                        <div class="cps-price-box">
                            <span class="cps-price-new">@string.Format(info, "{0:c0}", giaSauGiam)</span>
                            @if (phanTramChot > 0)
                            {
                                <span class="cps-price-old">@string.Format(info, "{0:c0}", btHienThi.GiaBan)</span>
                            }
                        </div>

                        @if (thuocTinhs.Any())
                        {
                            <div class="variant-tags">
                                @foreach (var tt in thuocTinhs)
                                {
                                    <span class="v-tag">@tt</span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <div class="block-title mt-5">
        <h2>✨ Sản Phẩm Mới Ra Mắt</h2>
    </div>
    <div class="grid-5-cols">
        @if (ViewBag.SanPhamMoi != null)
        {
            foreach (var sp in ViewBag.SanPhamMoi as List<Maison.Models.Sanpham>)
            {
                decimal minGiaSauGiam = decimal.MaxValue;
                decimal giaGocCuaBanReNhat = 0;
                int phanTramHienThi = 0;

                // TÌM CẤU HÌNH CÓ GIÁ RẺ NHẤT (LÀM MỒI NHỬ)
                if (sp.BienThes != null && sp.BienThes.Any())
                {
                    foreach (var bt in sp.BienThes)
                    {
                        var activeKMs = sp.SanPhamKhuyenMais != null
                            ? sp.SanPhamKhuyenMais.Where(k => k.KhuyenMai != null && k.KhuyenMai.TrangThai == 1 && k.KhuyenMai.NgayBatDau <= DateTime.Now && k.KhuyenMai.NgayKetThuc >= DateTime.Now)
                            : Enumerable.Empty<Maison.Models.SanPhamKhuyenMai>();

                        int maxRieng = activeKMs.Where(k => k.MaBT == bt.MaBT).Select(k => k.PhanTramGiam).DefaultIfEmpty(0).Max();
                        int maxChung = activeKMs.Where(k => k.MaBT == null).Select(k => k.PhanTramGiam).DefaultIfEmpty(0).Max();
                        int phanTram = Math.Max(maxRieng, maxChung);

                        decimal giaSauGiam = bt.GiaBan * (1 - (decimal)phanTram / 100);

                        if (giaSauGiam < minGiaSauGiam)
                        {
                            minGiaSauGiam = giaSauGiam;
                            giaGocCuaBanReNhat = bt.GiaBan;
                            phanTramHienThi = phanTram;
                        }
                    }
                }

                <div class="col-item">
                    <div class="cps-card">
                        @if (phanTramHienThi > 0)
                        {
                            <div class="discount-badge">Giảm @phanTramHienThi%</div>
                        }

                        <a href="@Url.Action("ProductDetail", "Product", new { id = sp.MaSP })" class="cps-card-img">
                            <img src="@sp.HinhAnh" onerror="this.src='/Content/Images/no-image.png'" alt="@sp.TenSP" />
                        </a>

                        <a href="@Url.Action("ProductDetail", "Product", new { id = sp.MaSP })" class="cps-card-title">
                            @sp.TenSP
                        </a>

                        <div class="cps-price-box">
                            @if (minGiaSauGiam != decimal.MaxValue)
                            {
                                <span class="cps-price-new">@string.Format(info, "{0:c0}", minGiaSauGiam)</span>
                                if (phanTramHienThi > 0)
                                {
                                    <span class="cps-price-old">@string.Format(info, "{0:c0}", giaGocCuaBanReNhat)</span>
                                }
                            }
                            else
                            {
                                <span class="cps-price-new text-muted" style="font-size:14px;">Đang cập nhật giá</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    <div class="block-title mt-5">
        <h2>💰 Giá Tốt Chốt Ngay</h2>
    </div>
    <div class="grid-5-cols">
        @if (ViewBag.GiaTot != null)
        {
            foreach (var sp in ViewBag.GiaTot as List<Maison.Models.Sanpham>)
            {
                decimal minGiaSauGiam = decimal.MaxValue;
                decimal giaGocCuaBanReNhat = 0;
                int phanTramHienThi = 0;

                // TÌM CẤU HÌNH CÓ GIÁ RẺ NHẤT (LÀM MỒI NHỬ)
                if (sp.BienThes != null && sp.BienThes.Any())
                {
                    foreach (var bt in sp.BienThes)
                    {
                        var activeKMs = sp.SanPhamKhuyenMais != null
                            ? sp.SanPhamKhuyenMais.Where(k => k.KhuyenMai != null && k.KhuyenMai.TrangThai == 1 && k.KhuyenMai.NgayBatDau <= DateTime.Now && k.KhuyenMai.NgayKetThuc >= DateTime.Now)
                            : Enumerable.Empty<Maison.Models.SanPhamKhuyenMai>();

                        int maxRieng = activeKMs.Where(k => k.MaBT == bt.MaBT).Select(k => k.PhanTramGiam).DefaultIfEmpty(0).Max();
                        int maxChung = activeKMs.Where(k => k.MaBT == null).Select(k => k.PhanTramGiam).DefaultIfEmpty(0).Max();
                        int phanTram = Math.Max(maxRieng, maxChung);

                        decimal giaSauGiam = bt.GiaBan * (1 - (decimal)phanTram / 100);

                        if (giaSauGiam < minGiaSauGiam)
                        {
                            minGiaSauGiam = giaSauGiam;
                            giaGocCuaBanReNhat = bt.GiaBan;
                            phanTramHienThi = phanTram;
                        }
                    }
                }

                <div class="col-item">
                    <div class="cps-card">
                        @if (phanTramHienThi > 0)
                        {
                            <div class="discount-badge">Giảm @phanTramHienThi%</div>
                        }

                        <a href="@Url.Action("ProductDetail", "Product", new { id = sp.MaSP })" class="cps-card-img">
                            <img src="@sp.HinhAnh" onerror="this.src='/Content/Images/no-image.png'" alt="@sp.TenSP" />
                        </a>

                        <a href="@Url.Action("ProductDetail", "Product", new { id = sp.MaSP })" class="cps-card-title">
                            @sp.TenSP
                        </a>

                        <div class="cps-price-box">
                            @if (minGiaSauGiam != decimal.MaxValue)
                            {
                                <span class="cps-price-new">@string.Format(info, "{0:c0}", minGiaSauGiam)</span>
                                if (phanTramHienThi > 0)
                                {
                                    <span class="cps-price-old">@string.Format(info, "{0:c0}", giaGocCuaBanReNhat)</span>
                                }
                            }
                            else
                            {
                                <span class="cps-price-new text-muted" style="font-size:14px;">Đang cập nhật giá</span>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
