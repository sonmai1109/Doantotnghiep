                                    <span class="v-tag" style="font-size: 11px; color: #555; background: #f3f4f6; padding: 3px 6px; border: 1px solid #e5e7eb; border-radius: 4px;">
                                        @tag
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
