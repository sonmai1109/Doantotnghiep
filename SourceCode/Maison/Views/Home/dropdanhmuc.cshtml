@model IEnumerable<Maison.Models.Danhmuc>
@using Maison.Models
@{
    shopdb db = new shopdb();
}

@foreach (var item in Model)
{
    <li class="cat-item">
        <a href="@Url.Action("Shop","Product", new { madm = item.MaDM })" class="d-flex justify-content-between align-items-center text-dark text-decoration-none">
            <span>@item.TenDM</span>
            <i class="fas fa-chevron-right text-muted" style="font-size: 12px;"></i>
        </a>

        <div class="mega-menu-brands shadow border rounded">
            <div class="row">

                <div class="col-md-6 border-right">
                    <h6 class="fw-bold mb-3 text-danger"><i class="fas fa-tags mr-1"></i> Hãng @item.TenDM</h6>
                    <div class="brand-grid">
                        @{
                            var brands = db.Brands.Where(b => b.Sanphams.Any(s => s.MaDM == item.MaDM || s.DanhMuc.MaDMCha == item.MaDM)).ToList();
                        }
                        @if (brands.Count > 0)
                        {
                            foreach (var br in brands)
                            {
                                <a href="@Url.Action("Shop", "Product", new { maBrand = br.MaBrand, madm = item.MaDM })" class="brand-item border rounded" title="@br.TenBrand">
                                    <img src="@br.Logo" alt="@br.TenBrand" onerror="this.src='/Content/Images/no-image.png'" />
                                </a>
                            }
                        }
                        else
                        {
                            <span class="text-muted" style="font-size: 13px;">Đang cập nhật...</span>
                        }
                    </div>
                </div>

                <div class="col-md-6 pl-4">
                    <h6 class="fw-bold mb-3 text-info"><i class="fas fa-list-ul mr-1"></i> Nhu cầu sử dụng</h6>
                    <div class="subcategory-grid">
                        @{
                            // Lấy các danh mục con có MaDMCha bằng với ID của dòng hiện tại
                            var subCats = db.Danhmucs.Where(d => d.MaDMCha == item.MaDM).ToList();
                        }
                        @if (subCats.Count > 0)
                        {
                            foreach (var sub in subCats)
                            {
                                <a href="@Url.Action("Shop", "Product", new { madm = sub.MaDM })" class="subcat-item">
                                    @sub.TenDM
                                </a>
                            }
                        }
                        else
                        {
                            <span class="text-muted font-italic" style="font-size: 13px;">(Chưa phân loại)</span>
                        }
                    </div>
                </div>

            </div>
        </div>
    </li>
}