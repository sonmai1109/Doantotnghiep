@model PagedList.IPagedList<Maison.Models.TinTuc>
@using PagedList.Mvc
@{
    ViewBag.Title = "Quản lý Tin Tức";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center py-4">
    <h2 class="h4 font-weight-bold text-primary"><i class="fas fa-newspaper mr-2"></i>Quản lý Tin Tức</h2>
    <a href="@Url.Action("Create")" class="btn btn-primary shadow-sm"><i class="fas fa-plus mr-2"></i>Viết bài mới</a>
</div>

<div class="card card-body border-0 shadow-sm table-responsive">
    <table class="table table-hover align-middle">
        <thead class="thead-light">
            <tr>
                <th style="width: 80px;">Ảnh</th>
                <th>Tiêu đề bài viết</th>
                <th>Ngày đăng</th>
                <th>Lượt xem</th>
                <th>Trạng thái</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr id="row-@item.MaTin">
                    <td><img src="@item.AnhDaiDien" width="60" class="rounded shadow-sm" onerror="this.src='/Content/Images/no-image.png'"></td>
                    <td><div class="font-weight-bold text-dark text-truncate" style="max-width: 350px;">@item.TieuDe</div></td>
                    <td>@item.NgayDang.Value.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><span class="badge badge-light border text-primary">@item.LuotXem</span></td>
                    <td>
                        <span class="badge @(item.TrangThai == 1 ? "badge-success" : "badge-secondary")">
                            @(item.TrangThai == 1 ? "Hiển thị" : "Ẩn")
                        </span>
                    </td>
                    <td class="text-center">
                        <a href="@Url.Action("Edit", new { id = item.MaTin })" class="btn btn-sm btn-info text-white"><i class="fas fa-edit"></i></a>
                        <button onclick="deleteNews(@item.MaTin)" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="mt-3">
        @Html.PagedListPager(Model, page => Url.Action("Index", new { page, q = ViewBag.q }))
    </div>
</div>

@section Script {
    <script>
        function deleteNews(id) {
            if (confirm("Bạn có chắc muốn xóa bài viết này?")) {
                $.post('/Admin/TinTucs/Delete', { id: id }, function (res) {
                    if (res.status) {
                        $('#row-' + id).fadeOut();
                    } else {
                        alert("Không thể xóa!");
                    }
                });
            }
        }
    </script>
}