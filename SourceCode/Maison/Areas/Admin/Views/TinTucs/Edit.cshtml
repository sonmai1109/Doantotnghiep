@model Maison.Models.TinTuc
@{
    ViewBag.Title = "Chỉnh sửa bài viết";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 font-weight-bold text-info">CẬP NHẬT BÀI VIẾT</h5>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Edit", "TinTucs", new { area = "Admin" }, FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                // BẮT BUỘC PHẢI CÓ DÒNG NÀY ĐỂ TRUYỀN ID CỦA BÀI VIẾT VỀ SERVER
                @Html.HiddenFor(m => m.MaTin)

                <div class="row">
                    <div class="col-md-8">
                        <div class="form-group mb-3">
                            <label class="font-weight-bold">Tiêu đề bài viết</label>
                            @Html.TextBoxFor(m => m.TieuDe, new { @class = "form-control", required = "required" })
                        </div>
                        <div class="form-group mb-3">
                            <label class="font-weight-bold">Tóm tắt ngắn</label>
                            @Html.TextAreaFor(m => m.TomTat, new { @class = "form-control", rows = "3", required = "required" })
                        </div>
                        <div class="form-group mb-3">
                            <label class="font-weight-bold">Nội dung chi tiết</label>
                            @Html.TextAreaFor(m => m.NoiDung, new { @id = "txtNoiDung" })
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="form-group mb-3">
                            <label class="font-weight-bold">Ảnh đại diện hiện tại</label><br />
                            <img id="previewImg" src="@Model.AnhDaiDien" class="w-100 rounded border mb-2" style="max-height: 200px; object-fit: cover;" onerror="this.src='/Content/Images/no-image.png'">

                            <label class="font-weight-bold text-info mt-2">Chọn ảnh mới (Để trống nếu muốn giữ ảnh cũ)</label>
                            <input type="file" name="ImageUpload" id="ImageUpload" class="form-control-file" accept="image/*">
                        </div>
                        <div class="form-group mb-3">
                            <label class="font-weight-bold">Trạng thái hiển thị</label>
                            @Html.DropDownListFor(m => m.TrangThai, new List<SelectListItem> {
                                new SelectListItem { Text = "Công khai bài viết", Value = "1" },
                                new SelectListItem { Text = "Lưu nháp (Ẩn)", Value = "0" }
                            }, new { @class = "form-control" })
                        </div>
                        <hr />
                        <button type="submit" class="btn btn-info btn-block font-weight-bold py-2 text-white"><i class="fas fa-save mr-2"></i> LƯU THAY ĐỔI</button>
                        <a href="@Url.Action("Index")" class="btn btn-light btn-block">Hủy bỏ</a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Script {
    <script src="https://cdn.ckeditor.com/4.16.2/standard/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('txtNoiDung', {
            height: 400
        });

        // Đổi ảnh Preview nếu Admin chọn File mới
        $('#ImageUpload').on('change', function () {
            var file = this.files[0];
            if (file) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#previewImg').attr('src', e.target.result);
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}