@model  PagedList.IPagedList<Maison.Models.Sanpham>
@using PagedList.Mvc;
@{
    ViewBag.Title = "Quản lý Sản phẩm gốc";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css" />

<style>
    /* Nâng cấp Popup: Nằm chính giữa màn hình chuẩn xác, bo góc mượt mà */
    .popupprivate, .popupprivate2, .changepopup, .deletepopup {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%); /* Kỹ thuật ép ra giữa màn hình */
        max-height: 90vh;
        overflow-y: auto;
        border-radius: 12px;
        z-index: 1050;
        width: 100%;
        max-width: 650px;
        background-color: white;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3) !important; /* Bóng đổ nổi bật */
        border: none !important;
    }

    /* Hiệu ứng mờ nền phía sau khi mở popup (Tùy chọn) */
    body.modal-open {
        overflow: hidden;
    }
</style>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center py-4">
    <div class="d-block mb-4 mb-md-0">
        <h2 class="h4 font-weight-bold"><i class="fas fa-boxes mr-2"></i> Danh sách Sản phẩm</h2>
        <p class="text-muted">Quản lý thông tin gốc của các sản phẩm trên hệ thống</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0">
        <button id="addpopup" class="btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus mr-2"></i>Thêm sản phẩm mới
        </button>
    </div>
</div>

<div class="card card-body border-light shadow-sm table-wrapper table-responsive pt-0 mb-4">
    <table class="table table-hover align-middle">
        <thead class="thead-light">
            <tr>
                <th>Hình ảnh</th>
                <th>Tên sản phẩm</th>
                <th>Danh mục</th>
                <th>Thương hiệu</th>
                <th>Bảo hành</th>
                <th>Người tạo</th>
                <th>Ngày tạo</th>
                <th style="width: 200px;">Mô tả</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="row-@item.MaSP">
                    <td>
                        <img src="@item.HinhAnh" style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid #eee;" onerror="this.src='/Content/Images/no-image.png'" />
                    </td>

                    <td><span class="font-weight-bold text-primary" style="font-size: 15px;">@item.TenSP</span></td>

                    <td><span class="badge badge-info px-2 py-1">@item.DanhMuc.TenDM</span></td>
                    <td><span class="font-weight-bold text-dark">@item.Brand.TenBrand</span></td>

                    <td>@item.ThoiHanBaoHanh tháng</td>

                    <td>
                        <span class="d-block font-weight-bold">@item.NguoiTao</span>
                        @if (!string.IsNullOrEmpty(item.NguoiSua))
                        {<small class="text-muted">Sửa bởi: @item.NguoiSua</small>}
                    </td>
                    <td>
                        <span class="d-block">@(item.NgayTao.ToString("dd/MM/yyyy"))</span>
                        @if (item.NgaySua != null)
                        {<small class="text-muted">Sửa: @(item.NgaySua?.ToString("dd/MM/yyyy"))</small>}
                    </td>

                    <td class="text-truncate text-muted" style="max-width: 200px;" title="@item.MoTa">
                        @(string.IsNullOrEmpty(item.MoTa) ? "Chưa có mô tả..." : item.MoTa)
                    </td>

                    <td class="text-center">
                        <div class="btn-group">
                            <a href="/Admin/BienThes/Index?maSP=@item.MaSP" class="btn btn-sm btn-success mr-2 rounded shadow-sm" title="Quản lý cấu hình chi tiết">
                                <i class="fas fa-microchip mr-1"></i> Cấu hình
                            </a>

                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle dropdown-toggle-split rounded shadow-sm" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="fas fa-ellipsis-h"></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-right shadow">
                                <button class="dropdown-item change font-weight-bold text-primary" onclick="loaddata(@item.MaSP)">
                                    <i class="fas fa-edit mr-2"></i>Sửa thông tin
                                </button>
                                <div class="dropdown-divider"></div>
                                <button class="dropdown-item text-danger delete font-weight-bold" onclick="deleteData(@item.MaSP)">
                                    <i class="fas fa-trash-alt mr-2"></i>Xóa sản phẩm
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="card-footer px-3 border-0 d-flex align-items-center justify-content-between">
        <nav aria-label="Page navigation example">
            <ul class="pagination mb-0">
                @(Model.PageCount < Model.PageNumber ? 0 : Model.PageNumber) / @Model.PageCount

                @Html.PagedListPager(Model, page => Url.Action("Index",
                    new { page, pageSize = Model.PageSize, searchString = ViewBag.searchString }))
            </ul>
        </nav>
    </div>
</div>

@section popup{
    <div class="popup popupprivate p-4" id="popup">
        <div>
            <form id="add-form" onsubmit="return themSanPham()">
                <p id="add-message"></p>
                <div class="text-center border-bottom pb-3 mb-4">
                    <h4 class="font-weight-bold text-primary m-0"><i class="fas fa-box-open mr-2"></i>Tạo Sản Phẩm Mới</h4>
                </div>

                <div class="form-group mb-3">
                    <label class="font-weight-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="TenSP" required autofocus placeholder="Ví dụ: Laptop Dell XPS 15...">
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="font-weight-bold">Danh mục <span class="text-danger">*</span></label>
                        @Html.DropDownList("MaDM", null, "--- Chọn danh mục ---", htmlAttributes: new { @class = "form-control", @required = "required" })
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="font-weight-bold">Thương hiệu <span class="text-danger">*</span></label>
                        @Html.DropDownList("MaBrand", null, "--- Chọn hãng ---", htmlAttributes: new { @class = "form-control", @required = "required" })
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="font-weight-bold">Thời gian bảo hành (Tháng) <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" name="ThoiHanBaoHanh" value="12" required min="0">
                </div>

                <div class="form-group mb-3">
                    <label class="font-weight-bold">Ảnh đại diện (Thumbnail) <span class="text-danger">*</span></label>
                    <input type="file" class="form-control-file border p-2 rounded w-100" name="ImageFile" accept="image/*" required>
                </div>

                <div class="form-group mb-4">
                    <label class="font-weight-bold">Mô tả tổng quan</label>
                    <textarea class="form-control" name="MoTa" rows="3" placeholder="Nhập bài viết giới thiệu ngắn về sản phẩm..."></textarea>
                </div>

                <div class="row">
                    <div class="col-6">
                        <div class="btn btn-block btn-light border font-weight-bold cancelPopup">Hủy bỏ</div>
                    </div>
                    <div class="col-6">
                        <button type="submit" class="btn btn-block btn-primary font-weight-bold"><i class="fas fa-save mr-1"></i> Lưu sản phẩm</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@section changepopup{
    <div class="changepopup popupprivate p-4" id="changepopup">
        <div>
            <form id="update-form" onsubmit="return suaSanPham()">
                <p id="update-message"></p>
                <div class="text-center border-bottom pb-3 mb-4">
                    <h4 class="font-weight-bold text-success m-0"><i class="fas fa-edit mr-2"></i>Sửa Thông Tin Sản Phẩm</h4>
                </div>

                <input type="hidden" id="masp" name="MaSP" />

                <div class="form-group mb-3">
                    <label class="font-weight-bold">Tên sản phẩm <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" name="TenSP" id="tensp" required>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="font-weight-bold">Danh mục <span class="text-danger">*</span></label>
                        @Html.DropDownList("MaDM", null, "--- Chọn danh mục ---", htmlAttributes: new { @class = "form-control", @id = "madm", @required = "required" })
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="font-weight-bold">Thương hiệu <span class="text-danger">*</span></label>
                        @Html.DropDownList("MaBrand", null, "--- Chọn hãng ---", htmlAttributes: new { @class = "form-control", @id = "mabrand", @required = "required" })
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="font-weight-bold">Thời gian bảo hành (Tháng) <span class="text-danger">*</span></label>
                    <input type="number" class="form-control" name="ThoiHanBaoHanh" id="baohanh" required min="0">
                </div>

                <div class="form-group mb-3">
                    <label class="font-weight-bold">Đổi ảnh mới <small class="text-muted">(Bỏ qua nếu giữ ảnh cũ)</small></label>
                    <input type="file" class="form-control-file border p-2 rounded w-100 bg-light" name="ImageFile" accept="image/*">
                </div>

                <div class="form-group mb-4">
                    <label class="font-weight-bold">Mô tả tổng quan</label>
                    <textarea class="form-control" name="MoTa" id="mota" rows="3"></textarea>
                </div>

                <div class="row">
                    <div class="col-6">
                        <div class="btn btn-block btn-light border font-weight-bold cancelPopup">Hủy bỏ</div>
                    </div>
                    <div class="col-6">
                        <button type="submit" class="btn btn-block btn-success font-weight-bold"><i class="fas fa-check mr-1"></i> Cập nhật thay đổi</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@section deletepopup{
    <div class="deletepopup popupprivate2 p-4 text-center" id="deletepopup">
        <div class="py-3">
            <div class="text-danger mb-3" style="font-size: 3rem;"><i class="fas fa-exclamation-triangle"></i></div>
            <h3 class="font-weight-bold text-dark mb-3">Xóa Sản Phẩm Này?</h3>
            <p id="delete-message"></p>
            <input type="hidden" id="delete-masp" name="MaSP" />
            <p class="text-muted mb-4">Toàn bộ các cấu hình (Biến thể) thuộc sản phẩm này cũng sẽ bị xóa vĩnh viễn. Bạn không thể hoàn tác hành động này!</p>

            <div class="row px-3">
                <div class="col-6">
                    <div class="btn btn-block btn-light border font-weight-bold cancelPopup">Hủy, đừng xóa</div>
                </div>
                <div class="col-6">
                    <button type="button" class="btn btn-block btn-danger font-weight-bold" onclick="xoaSanPham()">Đồng ý Xóa</button>
                </div>
            </div>
        </div>
    </div>
}

@section Script{
    <script src="~/Content/admin/JS/addpopup.js"></script>
    <script src="~/Content/admin/JS/sanpham.js"></script>
}