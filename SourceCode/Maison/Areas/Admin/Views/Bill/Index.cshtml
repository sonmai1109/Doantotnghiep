@model PagedList.IPagedList<Maison.Models.HoaDon>
@using PagedList.Mvc;
<link href="~/Content/PagedList.css" rel="stylesheet" type="text/css">
@{
    ViewBag.Title = "Đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center py-4">
    <div class="d-block mb-4 mb-md-0">
        <h2 class="h4">Danh sách hóa đơn</h2>
    </div>
</div>

<div class="table-settings mb-4">
    <form method="get" action="@Url.Action("Index")">
        <div class="row align-items-center">
            <div class="col-md-3 mb-2">
                <div class="input-group">
                    <button class="input-group-text" type="submit"><span class="fas fa-search"></span></button>
                    <input type="date" class="form-control" name="searchString" value="@ViewBag.searchString" onchange="this.form.submit()">
                </div>
            </div>
            <div class="col-md-3 mb-2">
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-phone"></i></span>
                    <input type="text" class="form-control" name="sdt" value="@ViewBag.Sdt" placeholder="Nhập Mã đơn hoặc SĐT..." onchange="this.form.submit()">
                </div>
            </div>
            <div class="col-md-3 mb-2">
                <select class="form-control" name="status" onchange="this.form.submit()">
                    <option value="">-- Trạng thái Đơn --</option>
                    <option @(ViewBag.Status == 0 ? "selected" : "") value="0">Đã hủy</option>
                    <option @(ViewBag.Status == 1 ? "selected" : "") value="1">Đang chuẩn bị</option>
                    <option @(ViewBag.Status == 2 ? "selected" : "") value="2">Đang giao</option>
                    <option @(ViewBag.Status == 3 ? "selected" : "") value="3">Đã hoàn thành</option>
                </select>
            </div>

            <div class="col-md-3 mb-2">
                <select class="form-control" name="phuongThuc" onchange="this.form.submit()">
                    <option value="">-- Phương thức TT --</option>
                    <option @(ViewBag.PhuongThuc == "COD" ? "selected" : "") value="COD">Tiền mặt (COD)</option>
                    <option @(ViewBag.PhuongThuc == "QR" ? "selected" : "") value="QR">Chuyển khoản (QR)</option>
                </select>
            </div>

            <div class="col-md-3 mb-2">
                <select class="form-control" name="trangThaiTT" onchange="this.form.submit()">
                    <option value="">-- Trạng thái TT --</option>
                    <option @(ViewBag.TrangThaiTT == 0 ? "selected" : "") value="0">Chưa thanh toán</option>
                    <option @(ViewBag.TrangThaiTT == 1 ? "selected" : "") value="1">Đã thanh toán</option>
                </select>
            </div>
        </div>
    </form>
</div>

<div class="card card-body border-light shadow-sm table-wrapper table-responsive pt-0">
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Mã Đơn</th>
                <th>Tên khách hàng</th>
                <th>Người nhận</th>
                <th>Ngày đặt</th>
                <th>Địa chỉ nhận</th>
                <th>Trạng thái</th>
                
                <th>Tùy chọn</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="font-weight-bold text-danger">#@item.MaHD</td>

                    <td>@item.TaiKhoanNguoiDung.HoTen</td>
                    <td><span class="font-weight-bold">@item.HoTenNguoiNhan</span></td>
                    <td>@item.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>

                    <td class="text-truncate" style="max-width: 150px;" title="@item.DiaChiNhan">
                        @item.DiaChiNhan
                    </td>

                    <td>
                        @if (item.TrangThai == 0)
                        {
                            <span class="badge badge-danger" style="font-size: 13px; padding: 8px 12px;">Đã hủy</span>
                        }
                        else
                        {
                            <select id="hd-trangthai-update-@item.MaHD" onchange="doiTrangThai(@item.MaHD)"
                                    class="form-control form-control-sm font-weight-bold @(item.TrangThai == 3 ? "text-success" : "text-primary")"
                                    style="width:140px;">
                                <option value="1" @(item.TrangThai == 1 ? "selected" : "")>Đang chuẩn bị</option>
                                <option value="2" @(item.TrangThai == 2 ? "selected" : "")>Đang giao</option>
                                <option value="3" @(item.TrangThai == 3 ? "selected" : "")>Đã thanh toán</option>
                            </select>
                        }
                    </td>
              
                    <td>
                        <button class="btn btn-sm btn-info text-white mr-2" onclick="loadDuLieuChiTiet(@item.MaHD)">
                            <i class="fas fa-eye"></i> Chi tiết
                        </button>

                        @if (item.TrangThai == 1 || item.TrangThai == 2)
                        {
                            <button class="btn btn-sm btn-danger text-white" onclick="huyDonHang(@item.MaHD)">
                                <i class="fas fa-trash-alt"></i> Hủy
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="card-footer px-3 border-0">
        @Html.PagedListPager(Model, page => Url.Action("Index",
            new
            {
                page,
                pageSize = Model.PageSize,
                searchString = ViewBag.searchString,
                status = ViewBag.Status,
                phuongThuc = ViewBag.PhuongThuc,     // THÊM DÒNG NÀY
                trangThaiTT = ViewBag.TrangThaiTT,
                sdt = ViewBag.Sdt// THÊM DÒNG NÀY
            }))
    </div>
</div>

<div class="modal fade" id="modalChiTiet" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title font-weight-bold">Chi tiết hóa đơn <span id="hd-mahd" class="text-danger"></span></h5>
                <button type="button" class="close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label>Tên người đặt</label>
                        <input class="form-control" id="hd-nguoidat" type="text" readonly disabled>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label>Tên người nhận</label>
                        <input class="form-control" id="hd-nguoinhan" type="text" readonly disabled>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label>Ngày đặt</label>
                        <input class="form-control" id="hd-ngaydat" type="text" readonly disabled>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label>Trạng thái</label>
                        <input class="form-control text-danger font-weight-bold" id="hd-trangthai" type="text" readonly disabled>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label>Phương thức TT</label>
                        <input class="form-control font-weight-bold text-primary" id="hd-phuongthuc" type="text" readonly disabled>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label>Trạng thái TT</label>
                        <input class="form-control font-weight-bold text-success" id="hd-trangthaitt" type="text" readonly disabled>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label>Số điện thoại</label>
                        <input class="form-control" id="hd-sdt" type="text" readonly disabled>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label>Địa chỉ nhận</label>
                        <input class="form-control" id="hd-diachi" type="text" readonly disabled>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label>Người sửa cuối</label>
                        <input class="form-control" id="hd-nguoisua" type="text" readonly disabled>
                    </div>
                    <div class="col-md-6 mb-2">
                        <label>Ngày sửa cuối</label>
                        <input class="form-control" id="hd-ngaysua" type="text" readonly disabled>
                    </div>
                </div>

                <div class="mt-4 mb-2"><label class="font-weight-bold">Danh sách sản phẩm mua:</label></div>
                <div class="table-responsive">
                    <table class="table table-hover table-bordered text-center align-middle">
                        <thead class="thead-light">
                            <tr>
                                <th>Hình ảnh</th>
                                <th class="text-left">Sản phẩm & Cấu hình</th>
                                <th>Đơn giá</th>
                                <th>SL</th>
                                <th>Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody id="hd-body"></tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <label>Ghi chú</label>
                    <textarea class="form-control" id="hd-ghichu" rows="3" disabled></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-dismiss="modal">Thoát</button>
            </div>
        </div>
    </div>
</div>

@section Script{
    <script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>

    <script>
        // 1. Hàm Hủy Đơn Hàng
        function huyDonHang(id) {
            swal({
                title: "Cảnh báo",
                text: "Bạn có chắc chắn muốn hủy đơn hàng này?",
                icon: "warning",
                buttons: ["Quay lại", "Đồng ý Hủy"],
                dangerMode: true,
            }).then((willDelete) => {
                if (willDelete) {
                    swal({ title: "Đang xử lý...", icon: "info", buttons: false, closeOnClickOutside: false });

                    $.ajax({
                        type: 'POST',
                        data: { "mahd": id, "stt": 0 },
                        url: '/Admin/Bill/ChangeStatus',
                        success: function (response) {
                            if (response.status == true) {
                                swal("Thành công!", "Đã hủy đơn hàng và hoàn lại tồn kho!", "success")
                                    .then(() => { window.location.reload(); });
                            } else {
                                swal("Thất bại!", response.message ? response.message : "Không thể hủy đơn", "error")
                                    .then(() => { window.location.reload(); });
                            }
                        },
                        error: function (xhr) {
                            console.log("Lỗi Hủy đơn:", xhr.responseText);
                            swal("Lỗi Code!", "Mở F12 -> Console để xem chi tiết.", "error");
                        }
                    });
                }
            });
        }

        // 2. Hàm Đổi Trạng Thái
        function doiTrangThai(id) {
            let tt = $("#hd-trangthai-update-" + id).val();

            swal({
                title: "Đang xử lý...",
                text: "Hệ thống đang cập nhật trạng thái...",
                icon: "info",
                buttons: false,
                closeOnClickOutside: false
            });

            $.ajax({
                type: 'POST',
                data: { "mahd": id, "stt": tt },
                url: '/Admin/Bill/ChangeStatus',
                success: function (response) {
                    if (response.status == true) {
                        swal("Thành công!", "Sửa trạng thái thành công!", "success")
                            .then(() => { window.location.reload(); });
                    } else {
                        swal("Thất bại!", response.message ? response.message : "Cập nhật không thành công", "error")
                            .then(() => { window.location.reload(); });
                    }
                },
                error: function (xhr) {
                    console.log("Lỗi Đổi trạng thái:", xhr.responseText);
                    swal("Lỗi Hệ Thống!", "Đường truyền AJAX thất bại. Mở F12 xem lỗi.", "error");
                }
            });
        }

        // 3. Hàm Load Dữ Liệu Lên Modal
        function loadDuLieuChiTiet(id) {
            $("#hd-body").empty();
            swal({ title: "Đang tải dữ liệu...", icon: "info", buttons: false, closeOnClickOutside: false }); 

            $.ajax({
                type: 'POST',
                data: { "id": id },
                url: '/Admin/Bill/GetDetails',
                success: function (response) {
                    swal.close(); // Đóng popup loading
                    
                    if (response.error) {
                        swal("Lỗi!", response.error, "error");
                        return;
                    }

                    let hd = response.hoadon;
                    $("#hd-mahd").text("#" + hd.MaHD);
                    $("#hd-nguoidat").val(hd.TaiKhoanNguoiDung.HoTen);
                    $("#hd-nguoinhan").val(hd.HoTenNguoiNhan);
                    $("#hd-trangthai").val(hd.TrangThai == 0 ? "Đã hủy" : (hd.TrangThai == 1 ? "Đang chuẩn bị" : (hd.TrangThai == 2 ? "Đang giao" : "Đã thanh toán")));
                    $("#hd-phuongthuc").val(hd.PhuongThucThanhToan === "QR" ? "Chuyển khoản mã QR" : "Tiền mặt (COD)");
                    $("#hd-trangthaitt").val(hd.TrangThaiThanhToan);
                    $("#hd-ngaydat").val(hd.NgayDat);
                    $("#hd-sdt").val(hd.SoDienThoaiNhan);
                    $("#hd-diachi").val(hd.DiaChiNhan);
                    $("#hd-nguoisua").val(hd.NguoiSua);
                    $("#hd-ngaysua").val(hd.NgaySua);
                    $("#hd-ghichu").val(hd.GhiChu);

                    let total = 0;
                    $.each(response.cthd, function (index, item) {
                        $("#hd-body").append(`
                            <tr>
                                <td><img src="${item.HinhAnh}" width="60" style="border-radius: 5px;" onerror="this.src='/Content/Images/no-image.png'" /></td>
                                <td class="text-left">
                                    <strong style="font-size: 15px;">${item.TenSP}</strong><br/>
                                    <small class="text-muted"><i class="fas fa-microchip"></i> ${item.CauHinh}</small>
                                </td>
                                <td>${item.GiaMua.toLocaleString('vi-VN')} đ</td>
                                <td><span class="badge badge-secondary" style="font-size:14px;">${item.SoLuongMua}</span></td>
                                <td class="text-danger font-weight-bold">${item.ThanhTien.toLocaleString('vi-VN')} đ</td>
                            </tr>
                        `);
                        total += item.ThanhTien;
                    });

                    $("#hd-body").append(`
                        <tr class="bg-light">
                            <td colspan="4" class="text-right font-weight-bold" style="font-size:16px;">Tổng cộng:</td>
                            <td class="text-danger font-weight-bold" style="font-size:18px;">${total.toLocaleString("vi-VN")} đ</td>
                        </tr>
                    `);

                    // Gọi Modal Bootstrap hiện lên
                    $('#modalChiTiet').modal('show');
                },
                error: function (xhr) {
                    swal("Lỗi!", "Không lấy được dữ liệu hóa đơn.", "error");
                    console.log("Lỗi lấy chi tiết:", xhr.responseText);
                }
            });
        }
    </script>
}