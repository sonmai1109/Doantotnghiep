@{
    ViewBag.Title = "Báo Cáo Kinh Doanh";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://unpkg.com/sweetalert/dist/sweetalert.min.js"></script>

<div class="py-4">
    <h2 class="h4 font-weight-bold"><i class="fas fa-chart-pie mr-2 text-primary"></i> Phân Tích Kết Quả Kinh Doanh</h2>
</div>

<div class="card card-body border-light shadow-sm mb-4">
    <div class="row align-items-end">
        <div class="col-md-3 mb-2">
            <label class="font-weight-bold">Từ ngày</label>
            <input type="date" class="form-control" id="txtTuNgay" value="@ViewBag.TuNgay" onchange="taiDuLieuThongKe()">
        </div>
        <div class="col-md-3 mb-2">
            <label class="font-weight-bold">Đến ngày</label>
            <input type="date" class="form-control" id="txtDenNgay" value="@ViewBag.DenNgay" onchange="taiDuLieuThongKe()">
        </div>
        <div class="col-md-3 mb-2">
            <label class="font-weight-bold text-primary">Xem theo đơn vị</label>
            <select class="form-control border-primary" id="ddlLoai" onchange="taiDuLieuThongKe()">
                <option value="ngay">Từng ngày</option>
                <option value="thang">Từng tháng</option>
                <option value="nam">Từng năm</option>
            </select>
        </div>
        <div class="col-md-3 mb-2">
            <button class="btn btn-dark btn-block font-weight-bold" onclick="taiDuLieuThongKe()">
                <i class="fas fa-sync-alt mr-1"></i> Làm mới dữ liệu
            </button>
        </div>
    </div>
</div>

<div class="row mb-4" id="box-tongket" style="display:none;">
    <div class="col-12 col-md-4 mb-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body">
                <h6 class="text-uppercase opacity-80">Tổng Doanh Thu</h6>
                <h3 class="font-weight-bold" id="lbl-tong-doanhthu">0 ₫</h3>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4 mb-3">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body">
                <h6 class="text-uppercase opacity-80">Lợi Nhuận Gộp (Ước tính)</h6>
                <h3 class="font-weight-bold" id="lbl-tong-loinhuan">0 ₫</h3>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4 mb-3">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body">
                <h6 class="text-uppercase opacity-80">Số Đơn Hoàn Thành</h6>
                <h3 class="font-weight-bold" id="lbl-tong-sodon">0 đơn</h3>
            </div>
        </div>
    </div>
</div>

<div class="card card-body border-light shadow-sm pt-4">
    <div style="position: relative; height:55vh; width:100%">
        <canvas id="businessChart"></canvas>
    </div>
</div>
<div class="row mt-4">
    <div class="col-md-6 mb-4">
        <div class="card border-light shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="fas fa-arrow-up mr-2"></i>Top 5 Bán Chạy Nhất</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Đã bán</th>
                                <th class="text-right">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody id="tb-ban-chay">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-4">
        <div class="card border-light shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="fas fa-arrow-down mr-2"></i>Top 5 Bán Chậm Nhất</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Đã bán</th>
                                <th class="text-right">Doanh thu</th>
                            </tr>
                        </thead>
                        <tbody id="tb-ban-cham">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@section Script{
    <script>
        let myChart = null;
        const formatter = new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' });

        $(document).ready(function () {
            taiDuLieuThongKe();
        });

        function taiDuLieuThongKe() {
            let tuNgay = $('#txtTuNgay').val();
            let denNgay = $('#txtDenNgay').val();
            let loai = $('#ddlLoai').val()

            if (tuNgay > denNgay) {
                swal("Lỗi!", "Từ ngày không được lớn hơn Đến ngày!", "error");
                return;
            }
            $.ajax({
                type: 'POST',
                url: '@Url.Action("GetDoanhThuTongHop", "ThongKe")',
                data: { tuNgay: tuNgay, denNgay: denNgay, loai: loai },
                success: function (res) {
                    if (res.status) {
                        $("#box-tongket").fadeIn();
                        $("#lbl-tong-doanhthu").text(formatter.format(res.tongDoanhThu));
                        $("#lbl-tong-loinhuan").text(formatter.format(res.tongLoiNhuan));
                        $("#lbl-tong-sodon").text(res.tongSoDon + " đơn");

                        veBieuDo(res.labels, res.doanhThu, res.loiNhuan, res.soDon);
                    } else {
                        swal("Thông báo", res.message, "warning");
                    }
                }
            });
            // 2. AJAX LẤY DỮ LIỆU TOP SẢN PHẨM (THÊM MỚI VÀO ĐÂY)
            // Thêm đoạn này vào bên dưới đoạn Ajax vẽ biểu đồ cũ
            // 2. AJAX LẤY DỮ LIỆU TOP SẢN PHẨM (THÊM MỚI VÀO ĐÂY)
            $.ajax({
                url: '/Admin/ThongKe/GetTopSanpham',
                type: 'POST',
                data: { tuNgay: tuNgay, denNgay: denNgay },
                success: function (res) {
                    if (res.status) {
                        let htmlChay = '';
                        let htmlCham = '';

                        // Hàm tạo HTML cho 1 dòng dữ liệu
                        // Tìm đoạn render trong success của Ajax và thay thế bằng đoạn này cho chuyên nghiệp
                        const renderRow = (item, isTopChay) => {
                            // Nếu bán chậm mà số lượng = 0 thì cho màu đỏ đậm, nếu có bán được ít thì màu cam
                            let colorClass = isTopChay ? 'text-success' : (item.SoLuongBan === 0 ? 'text-danger font-weight-bolder' : 'text-warning');
                            let labelSl = item.SoLuongBan === 0 ? '<span class="badge badge-danger">Chưa bán được</span>' : item.SoLuongBan;

                            return `
        <tr>
            <td>
                <div class="d-flex align-items-center">
                    <img src="${item.HinhAnh}" width="40" height="40" class="mr-2 rounded border" style="object-fit:cover;">
                    <div>
                        <div class="font-weight-bold text-dark" style="font-size:12px; line-height:1.2;">${item.TenSP}</div>
                        <small class="text-muted" style="font-size:10px;">${item.CauHinh}</small>
                    </div>
                </div>
            </td>
            <td class="text-center font-weight-bold ${colorClass}">${isTopChay ? item.SoLuongBan : labelSl}</td>
            <td class="text-right text-dark font-weight-bold" style="font-size:12px;">${item.DoanhThuMangLai.toLocaleString('vi-VN')} đ</td>
        </tr>`;
                        };

                        // Render Top Bán Chạy
                        if (res.topBanChay.length > 0) {
                            res.topBanChay.forEach(item => htmlChay += renderRow(item, 'text-success'));
                        } else {
                            htmlChay = '<tr><td colspan="3" class="text-center py-4 text-muted">Không có dữ liệu bán hàng</td></tr>';
                        }
                        $('#tb-ban-chay').html(htmlChay);

                        // Render Top Bán Chậm
                        if (res.topBanCham.length > 0) {
                            res.topBanCham.forEach(item => htmlCham += renderRow(item, 'text-warning'));
                        } else {
                            htmlCham = '<tr><td colspan="3" class="text-center py-4 text-muted">Không có dữ liệu bán hàng</td></tr>';
                        }
                        $('#tb-ban-cham').html(htmlCham);
                    } else {
                        console.error("Lỗi từ server: ", res.message);
                    }
                },
                error: function (err) {
                    console.error("Lỗi kết nối API Top sản phẩm", err);
                }
            });
        }

        function veBieuDo(labels, doanhThu, loiNhuan, soDon) {
            const ctx = document.getElementById('businessChart').getContext('2d');
            if (myChart) myChart.destroy();

            myChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Lợi Nhuận (VNĐ)',
                            type: 'line',
                            data: loiNhuan,
                            borderColor: '#10B981', // Xanh lá
                            backgroundColor: '#10B981',
                            borderWidth: 3,
                            fill: false,
                            tension: 0.3, // Làm mượt đường kẻ
                            yAxisID: 'y'
                        },
                        {
                            label: 'Doanh Thu (VNĐ)',
                            data: doanhThu,
                            backgroundColor: 'rgba(54, 162, 235, 0.5)', // Xanh biển nhạt
                            borderColor: 'rgb(54, 162, 235)',
                            borderWidth: 1,
                            borderRadius: 5,
                            yAxisID: 'y'
                        },
                        {
                            label: 'Số lượng đơn',
                            type: 'line',
                            data: soDon,
                            borderColor: '#F59E0B', // Màu cam
                            backgroundColor: '#F59E0B',
                            borderWidth: 2,
                            borderDash: [5, 5], // Đường đứt nét cho số đơn
                            yAxisID: 'y1'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            type: 'linear', position: 'left',
                            title: { display: true, text: 'Tiền (VNĐ)' },
                            ticks: { callback: v => v.toLocaleString('vi-VN') }
                        },
                        y1: {
                            type: 'linear', position: 'right',
                            title: { display: true, text: 'Số đơn hàng' },
                            grid: { drawOnChartArea: false },
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });
        }
    </script>
}