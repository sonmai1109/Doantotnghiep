@model Maison.Areas.Admin.Data.LoginAccount

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - Quản trị viên</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />

    <style>
        body {
            /* Nền xanh gradient cực ngầu và quyền lực */
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
        }

        .login-container {
            width: 100%;
            max-width: 420px;
            padding: 15px;
        }

        .login-card {
            background: #ffffff;
            border-radius: 12px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            border-top: 5px solid #3b82f6; /* Điểm nhấn viền xanh */
            padding: 40px 30px;
        }

        .admin-icon {
            font-size: 3.5rem;
            color: #3b82f6;
            margin-bottom: 15px;
        }

        /* Tùy chỉnh ô nhập liệu để đẹp trên mọi phiên bản Bootstrap */
        .custom-input-group {
            display: flex;
            align-items: center;
            border: 1px solid #ced4da;
            border-radius: 6px;
            overflow: hidden;
            background: #fff;
            transition: all 0.3s;
        }

            .custom-input-group:focus-within {
                border-color: #3b82f6;
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
            }

        .custom-icon {
            padding: 10px 15px;
            background-color: #f8fafc;
            color: #64748b;
            border-right: 1px solid #ced4da;
        }

        .custom-input {
            flex: 1;
            border: none;
            padding: 10px 15px;
            outline: none;
            box-shadow: none;
        }

        .btn-login {
            background-color: #2563eb;
            color: white;
            border: none;
            padding: 12px;
            font-size: 16px;
            font-weight: bold;
            border-radius: 6px;
            width: 100%;
            margin-top: 10px;
            transition: all 0.3s;
        }

            .btn-login:hover {
                background-color: #1d4ed8;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(37, 99, 235, 0.4);
            }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="login-card">
            <div class="text-center mb-4">
                <i class="fas fa-user-shield admin-icon"></i>
                <h4 style="font-weight: 700; color: #333;">HỆ THỐNG QUẢN TRỊ</h4>
                <p class="text-muted" style="font-size: 14px;">Vui lòng đăng nhập để tiếp tục</p>
            </div>

            @using (Html.BeginForm("Index", "Login", FormMethod.Post))
            {
                @Html.ValidationMessage("ErrorLogin", new { @class = "text-danger text-center d-block mb-3 font-weight-bold" })

                <div class="form-group mb-3">
                    <label style="font-weight: 600; color: #555; margin-bottom: 5px; display: block;">Tên đăng nhập</label>
                    <div class="custom-input-group">
                        <div class="custom-icon"><i class="fas fa-user"></i></div>
                        @Html.TextBoxFor(model => model.username, new { @class = "custom-input", @autofocus = "autofocus", @required = "required", @placeholder = "Nhập tài khoản..." })
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label style="font-weight: 600; color: #555; margin-bottom: 5px; display: block;">Mật khẩu</label>
                    <div class="custom-input-group">
                        <div class="custom-icon"><i class="fas fa-lock"></i></div>
                        @Html.PasswordFor(model => model.password, new { @class = "custom-input", @required = "required", @placeholder = "••••••••" })
                    </div>
                </div>

                <div class="form-check mb-4" style="padding-left: 0;">
                    <label style="display: flex; align-items: center; cursor: pointer; color: #666; font-size: 14px;">
                        @Html.CheckBoxFor(model => model.rememberme, new { style = "margin-right: 8px; width: 16px; height: 16px;" })
                        Nhớ phiên đăng nhập
                    </label>
                </div>

                <button type="submit" class="btn-login">
                    <i class="fas fa-sign-in-alt" style="margin-right: 5px;"></i> ĐĂNG NHẬP
                </button>
            }
        </div>
    </div>

</body>
</html>