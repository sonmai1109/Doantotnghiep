@model IEnumerable<Maison.Models.BienThe>
@{
    ViewBag.Title = "Cấu hình Sản phẩm";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

<style>
    /* Popup luôn ở giữa màn hình, hiệu ứng Card UI bóng đổ chuẩn xác */
    .popupprivate, .changepopup, .deletepopup {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%); /* Căn giữa hoàn hảo */
        max-height: 90vh;
        overflow-y: auto;
        border-radius: 12px;
        z-index: 1050;
        width: 100%;
        max-width: 650px;
        background-color: white;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3) !important;
        border: none !important;
    }

    /* Hiệu ứng hover cho ảnh Gallery */
    .gallery-img-wrapper img {
        transition: transform 0.2s;
    }

    .gallery-img-wrapper:hover img {
        transform: scale(1.1);
    }
</style>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center py-4">
    <div class="d-block mb-4 mb-md-0">
        <h2 class="h4 font-weight-bold"><i class="fas fa-microchip mr-2"></i> Cấu hình chi tiết</h2>
        <p class="text-muted">Sản phẩm: <span class="font-weight-bold text-primary" style="font-size: 16px;">@ViewBag.TenSP</span></p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a href="/Admin/Sanphams" class="btn btn-sm btn-light border mr-3 shadow-sm font-weight-bold">
            <i class="fas fa-arrow-left mr-1"></i> Quay lại
        </a>

        <button id="btnBulkCreate" class="btn btn-sm btn-success shadow-sm font-weight-bold mr-2">
            <i class="fas fa-layer-group mr-1"></i> Tạo hàng loạt
        </button>

        <button id="addpopup" class="btn btn-sm btn-primary shadow-sm font-weight-bold">
            <i class="fas fa-plus mr-1"></i> Thêm biến thể mới
        </button>
    </div>
</div>

<div class="card card-body border-light shadow-sm table-wrapper table-responsive pt-0 mb-4">
    <table class="table table-hover align-middle text-center">
        <thead class="thead-light">
            <tr>
                <th>Ảnh chính</th>
                <th class="text-left">Ảnh phụ (Gallery)</th>
                <th>Giá bán</th>
                <th>Tồn kho</th>
                <th class="text-left" style="width: 250px;">Thông số kỹ thuật</th>
                <th>Cập nhật cuối</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="row-@item.MaBT">
                    <td>
                        <img src="@item.HinhAnh" style="width: 80px; height: 80px; object-fit: cover; border-radius: 8px; border: 1px solid #eee; box-shadow: 0 2px 5px rgba(0,0,0,0.05);" onerror="this.src='/Content/Images/no-image.png'" />
                    </td>

                    <td class="text-left">
                        <div style="display: flex; gap: 5px; flex-wrap: wrap; width: fit-content;">
                            @if (item.ThuVienAnhs != null && item.ThuVienAnhs.Any())
                            {
                                var sortedGallery = item.ThuVienAnhs.OrderBy(x => x.ThuTu).ToList();
                                int totalImgs = sortedGallery.Count;

                                foreach (var img in sortedGallery.Take(5))
                                {
                                    <div class="gallery-img-wrapper" style="overflow: hidden; border-radius: 6px; border: 1px solid #ddd; width: 40px; height: 40px;">
                                        <img src="@img.DuongDanAnh" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/Content/Images/no-image.png'" title="Ảnh phụ" />
                                    </div>
                                }
                                if (totalImgs > 5)
                                {
                                    <div class="d-flex align-items-center justify-content-center bg-light text-primary font-weight-bold shadow-sm" style="width: 40px; height: 40px; border-radius: 6px; border: 1px solid #cce5ff; font-size: 12px; cursor: help;" title="Còn @(totalImgs - 5) ảnh nữa">
                                        +@(totalImgs - 5)
                                    </div>
                                }
                            }
                            else
                            {
                                <span class="badge badge-light text-muted border py-2 px-3">Trống</span>
                            }
                        </div>
                    </td>

                    <td><span class="font-weight-bold text-danger" style="font-size: 16px;">@item.GiaBan.ToString("N0") ₫</span></td>
                    <td>
                        @if (item.SoLuongTon > 0)
                        {<span class="badge badge-success px-2 py-1" style="font-size:14px;">@item.SoLuongTon</span> }
                    else
                    { <span class="badge badge-danger px-2 py-1" style="font-size:14px;">Hết hàng</span>}
                    </td>

                    <td class="text-left">
                        <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                            @if (item.ChiTietBTs != null && item.ChiTietBTs.Any())
                            {
                                // Đưa thông số chính lên đầu tiên để dễ nhìn
                                var danhSachThongSo = item.ChiTietBTs.OrderByDescending(c => c.GiaTriTT.ThuocTinh.LaThuocTinhChinh).ToList();

                                foreach (var ct in danhSachThongSo)
                                {
                                    // Kiểm tra xem đây có phải là thuộc tính chính không
                                    if (ct.GiaTriTT.ThuocTinh.LaThuocTinhChinh == true)
                                    {
                                        <span class="badge badge-danger" style="font-weight: 600; font-size: 12px; padding: 5px 8px; box-shadow: 0 2px 4px rgba(220,53,69,0.3);">
                                            <i class="fas fa-star text-warning" style="font-size: 10px; margin-right: 3px;"></i>
                                            @ct.GiaTriTT.ThuocTinh.TenTT: <b>@ct.GiaTriTT.GiaTri</b>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-light" style="font-weight: 500; font-size: 12px; padding: 5px 8px; border: 1px solid #ddd; color: #555;">
                                            @ct.GiaTriTT.ThuocTinh.TenTT: @ct.GiaTriTT.GiaTri
                                        </span>
                                    }
                                }
                            }
                            else
                            {
                                <span class="text-muted font-italic" style="font-size:13px;">Chưa cài đặt thông số</span>
                            }
                        </div>
                    </td>

                    <td>
                        <span class="d-block">@(item.NgaySua != null ? item.NgaySua?.ToString("dd/MM/yy") : item.NgayTao?.ToString("dd/MM/yy"))</span>
                        <small class="text-muted font-weight-bold">Bởi: @(string.IsNullOrEmpty(item.NguoiSua) ? item.NguoiTao : item.NguoiSua)</small>
                    </td>

                    <td>
                        <div class="btn-group">
                            <button class="btn btn-sm btn-outline-secondary dropdown-toggle dropdown-toggle-split rounded shadow-sm" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                <span class="fas fa-ellipsis-h"></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-right shadow">
                                <button class="dropdown-item change font-weight-bold text-primary" onclick="loaddata(@item.MaBT)">
                                    <i class="fas fa-edit mr-2"></i>Sửa cấu hình
                                </button>
                                <div class="dropdown-divider"></div>
                                <button class="dropdown-item text-danger delete font-weight-bold" onclick="deleteData(@item.MaBT)">
                                    <i class="fas fa-trash-alt mr-2"></i>Xóa
                                </button>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section popup{
    <div class="popup popupprivate p-4" id="popup">
        <div>
            <form id="add-form" onsubmit="return themBienThe()">
                <p id="add-message"></p>
                <div class="text-center border-bottom pb-3 mb-4">
                    <h4 class="font-weight-bold text-primary m-0"><i class="fas fa-layer-group mr-2"></i>Tạo Biến Thể Mới</h4>
                </div>

                <input type="hidden" name="MaSP" id="current_MaSP" value="@ViewBag.MaSP" />
                <input type="hidden" id="current_MaDM" value="@ViewBag.MaDM" />

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="font-weight-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="GiaBan" required autofocus min="0">
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="font-weight-bold">Số lượng kho <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="SoLuongTon" required min="0">
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="font-weight-bold">Ảnh đại diện <span class="text-danger">*</span></label>
                    <input type="file" class="form-control-file border p-2 rounded w-100" name="ImageFile" accept="image/*" required>
                </div>

                <div class="form-group mb-4">
                    <label class="font-weight-bold text-info"><i class="fas fa-images mr-1"></i> Tải nhiều ảnh phụ (Gallery)</label>
                    <input type="file" class="form-control-file border p-2 rounded w-100 bg-light" name="GalleryFiles" accept="image/*" multiple>
                </div>

                <div class="p-3 mb-4 bg-light rounded" style="border: 1px dashed #ccc;">
                    <h6 class="font-weight-bold text-primary mb-3"><i class="fas fa-cogs mr-1"></i> Chọn thông số phần cứng:</h6>
                    <div id="dynamic-attributes-add">
                        <span class="text-muted font-italic">Đang tải dữ liệu...</span>
                    </div>
                </div>

                <div class="row px-2">
                    <div class="col-6">
                        <div class="btn btn-block btn-light border font-weight-bold cancelPopup">Hủy bỏ</div>
                    </div>
                    <div class="col-6">
                        <button type="submit" class="btn btn-block btn-primary font-weight-bold"><i class="fas fa-save mr-1"></i> Lưu cấu hình</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@section changepopup{
    <div class="changepopup popupprivate p-4" id="changepopup">
        <div>
            <form id="update-form" onsubmit="return suaBienThe()">
                <p id="update-message"></p>
                <div class="text-center border-bottom pb-3 mb-4">
                    <h4 class="font-weight-bold text-success m-0"><i class="fas fa-edit mr-2"></i>Sửa Biến Thể</h4>
                </div>

                <input type="hidden" id="mabt" name="MaBT" />

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="font-weight-bold">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="GiaBan" id="giaban" required min="0">
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="font-weight-bold">Số lượng kho <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="SoLuongTon" id="soluongton" required min="0">
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label class="font-weight-bold">Đổi ảnh chính <small class="text-muted">(Bỏ trống nếu giữ cũ)</small></label>
                    <input type="file" class="form-control-file border p-2 rounded w-100" name="ImageFile" accept="image/*">
                </div>

                <div class="form-group mb-2">
                    <label class="font-weight-bold text-info"><i class="fas fa-upload mr-1"></i> Upload thêm ảnh phụ (Gallery)</label>
                    <input type="file" id="GalleryInputAjax" class="form-control-file border p-2 rounded w-100 bg-light" accept="image/*" multiple onchange="autoUploadGallery()">
                </div>

                <div class="form-group mb-4">
                    <label class="font-weight-bold text-secondary" style="font-size: 13px;">Quản lý Ảnh phụ hiện tại:</label>
                    <div id="gallery-container" class="d-flex flex-wrap shadow-inner" style="gap: 10px; min-height: 70px; padding: 10px; border: 1px dashed #ccc; border-radius: 8px; background: #f8f9fa;">
                    </div>
                </div>

                <div class="p-3 mb-4 bg-light rounded" style="border: 1px dashed #ccc;">
                    <h6 class="font-weight-bold text-primary mb-3"><i class="fas fa-cogs mr-1"></i> Cập nhật thông số:</h6>
                    <div id="dynamic-attributes-edit">
                        <span class="text-muted font-italic">Đang tải dữ liệu...</span>
                    </div>
                </div>

                <div class="row px-2">
                    <div class="col-6">
                        <div class="btn btn-block btn-light border font-weight-bold cancelPopup">Hủy bỏ</div>
                    </div>
                    <div class="col-6">
                        <button type="submit" class="btn btn-block btn-success font-weight-bold"><i class="fas fa-check mr-1"></i> Cập nhật</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@section deletepopup{
    <div class="deletepopup popupprivate p-4 text-center" id="deletepopup">
        <div class="py-3">
            <div class="text-danger mb-3" style="font-size: 3rem;"><i class="fas fa-exclamation-triangle"></i></div>
            <h3 class="font-weight-bold text-dark mb-3">Xóa Biến Thể Này?</h3>
            <p id="delete-message"></p>
            <input type="hidden" id="delete-mabt" name="MaBT" />
            <p class="text-muted mb-4">Bạn chắc chắn muốn xóa vĩnh viễn cấu hình này chứ? Các dữ liệu liên quan sẽ bị ảnh hưởng.</p>

            <div class="row px-3">
                <div class="col-6">
                    <div class="btn btn-block btn-light border font-weight-bold cancelPopup">Hủy, không xóa</div>
                </div>
                <div class="col-6">
                    <button type="button" class="btn btn-block btn-danger font-weight-bold" onclick="xoaBienThe()">Đồng ý Xóa</button>
                </div>
            </div>
        </div>
    </div>
}
@section bulkpopup{
    <div class="bulkpopup popupprivate p-4" id="bulkpopup" style="max-width: 800px; display:none;">
        <div>
            <form id="bulk-form">
                <div class="text-center border-bottom pb-3 mb-4">
                    <h4 class="font-weight-bold text-success m-0"><i class="fas fa-layer-group mr-2"></i>Tạo Hàng Loạt Biến Thể</h4>
                    <p class="text-muted mb-0 mt-2">Hệ thống sẽ tự động nhân chéo các thông số bạn chọn.</p>
                </div>

                <div class="row">
                    <div class="col-md-6 form-group mb-3">
                        <label class="font-weight-bold">Giá bán chung (VNĐ) <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="BulkGiaBan" id="bulk_giaban" required min="0">
                        <small class="text-muted">Bạn có thể sửa lại giá từng bản sau.</small>
                    </div>
                    <div class="col-md-6 form-group mb-3">
                        <label class="font-weight-bold">Số lượng kho chung <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" name="BulkSoLuongTon" id="bulk_soluongton" required min="0" value="10">
                    </div>
                </div>

                <div class="p-3 mb-4 bg-light rounded" style="border: 1px dashed #ccc; max-height: 400px; overflow-y: auto;">
                    <h6 class="font-weight-bold text-primary mb-3"><i class="fas fa-check-square mr-1"></i> Tick chọn các thông số muốn tạo:</h6>
                    <div id="dynamic-attributes-bulk">
                        <span class="text-muted font-italic">Đang tải dữ liệu...</span>
                    </div>
                </div>

                <div class="row px-2">
                    <div class="col-6">
                        <div class="btn btn-block btn-light border font-weight-bold cancelPopup" onclick="$('#bulkpopup, #overlay').hide();">Hủy bỏ</div>
                    </div>
                    <div class="col-6">
                        <button type="button" class="btn btn-block btn-success font-weight-bold" onclick="taoHangLoat()"><i class="fas fa-bolt mr-1"></i> Bắt đầu Tự Động Tạo</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@section Script{
    <script src="~/Content/admin/JS/addpopup.js"></script>
    <script src="~/Content/admin/JS/bienthe.js"></script>
}